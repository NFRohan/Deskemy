// Player overlay. Design language after Plezy's player view: controls sit
// directly on the video, monochrome, no panels — only soft scrims top and
// bottom for legibility — with a thin seek bar and "Ends at" time.

/// One entry in a track / chapter / speed menu.
export struct MenuItem {
    id: int,
    label: string,
    /// Secondary text before the label (a chapter's start time).
    detail: string,
    selected: bool,
}

/// Playback state pushed from Rust, and the user's actions sent back to it.
export global Playback {
    in property <string> title;
    in property <string> subtitle;
    in property <string> stats;
    in property <string> clock;
    in property <string> ends-at;
    in property <string> up-next;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume: 100;
    in property <bool> muted;
    in property <bool> fullscreen;
    in property <bool> has-previous;
    in property <bool> has-next;
    in property <string> speed-label: "1×";
    in property <bool> subtitles-on;
    in property <[MenuItem]> speeds;
    in property <[MenuItem]> subtitles;
    in property <[MenuItem]> audio-tracks;
    in property <[MenuItem]> chapters;
    /// Which overlay menu is open ("" = none); two-way bound to the overlay.
    in-out property <string> open-menu;
    /// Sleep timer: "off", "minutes" or "lecture"; the badge is e.g. "27m".
    in property <string> sleep-mode: "off";
    in property <string> sleep-badge;
    in property <int> sleep-minutes;

    callback back();
    callback toggle-pause();
    callback seek(float);
    callback seek-by(float);
    callback previous();
    callback next();
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-fullscreen();
    callback pick-speed(int);
    callback pick-subtitle(int);
    callback pick-audio(int);
    callback pick-chapter(int);
    callback sleep-for(int);
    callback sleep-at-end();
    callback sleep-off();
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 22px;
    in property <bool> enabled: true;
    /// Highlighted while its menu is open or its feature is on.
    in property <bool> active;
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: self.width / 2;
    background: root.active ? #ffffff2e : touch.has-hover && root.enabled ? #ffffff1f : transparent;

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? #ffffff4d : touch.pressed ? #ffffffb3 : #ffffff;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A thin scrubbable track; `value` is 0..1. `changed` fires continuously while
// dragging, `committed` once on release (seeking commits, volume follows live).
component Scrubber inherits Rectangle {
    in property <float> value;
    out property <float> preview;
    out property <bool> dragging: touch.pressed;
    callback changed(float);
    callback committed(float);

    property <float> shown: max(0, min(1, touch.pressed ? root.preview : root.value));
    property <length> track: touch.has-hover || touch.pressed ? 5px : 3px;

    height: 20px;

    Rectangle {
        y: (parent.height - root.track) / 2;
        width: parent.width;
        height: root.track;
        border-radius: root.track / 2;
        background: #ffffff40;

        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: parent.height;
            border-radius: parent.border-radius;
            background: #ffffff;
        }
    }

    if touch.has-hover || touch.pressed: Rectangle {
        x: root.width * root.shown - self.width / 2;
        width: 13px;
        height: 13px;
        border-radius: self.width / 2;
        background: #ffffff;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.preview = max(0, min(1, self.mouse-x / root.width));
                    root.changed(root.preview);
                } else if event.kind == PointerEventKind.up {
                    root.committed(root.preview);
                }
            }
        }
        moved => {
            if self.pressed {
                root.preview = max(0, min(1, self.mouse-x / root.width));
                root.changed(root.preview);
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    min-width: 56px;
    border-radius: 8px;
    background: root.selected ? #ffffff : touch.has-hover ? #ffffff2e : #ffffff1a;

    Text {
        text: root.text;
        color: root.selected ? #000000 : #ffffff;
        font-size: 13px;
        font-weight: 600;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuRow inherits Rectangle {
    in property <MenuItem> item;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? #ffffff1a : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        if root.item.detail != "": Text {
            text: root.item.detail;
            color: #ffffff99;
            font-size: 12px;
            vertical-alignment: center;
            min-width: 52px;
        }
        Text {
            text: root.item.label;
            color: #ffffff;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Image {
            source: @image-url("icons/check.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: #ffffff;
            opacity: root.item.selected ? 1 : 0;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PlayerOverlay inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    /// Diagnostics under the title (decoder in use) — for the port spike.
    in property <string> stats;
    in property <string> clock;
    in property <string> ends-at;
    in property <string> up-next;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume;
    in property <bool> muted;
    in property <bool> fullscreen;
    in property <bool> has-previous;
    in property <bool> has-next;
    in property <string> speed-label;
    in property <bool> subtitles-on;
    in property <[MenuItem]> speeds;
    in property <[MenuItem]> subtitles;
    in property <[MenuItem]> audio-tracks;
    in property <[MenuItem]> chapters;
    in property <string> sleep-mode;
    in property <string> sleep-badge;
    in property <int> sleep-minutes;

    callback back();
    callback toggle-pause();
    callback seek(float);
    callback seek-by(float);
    callback previous();
    callback next();
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-fullscreen();
    callback pick-speed(int);
    callback pick-subtitle(int);
    callback pick-audio(int);
    callback pick-chapter(int);
    callback sleep-for(int);
    callback sleep-at-end();
    callback sleep-off();

    in-out property <bool> controls-shown: true;
    /// Which menu is open: "" (none), "speed", "sub", "audio" or "chapters".
    in-out property <string> open-menu;
    // Never auto-hide while paused, mid-drag or with a menu open.
    property <bool> pinned: root.paused || seek-bar.dragging || volume-bar.dragging || root.open-menu != "";

    function toggle-menu(name: string) {
        root.open-menu = root.open-menu == name ? "" : name;
    }

    pure function pad(n: float) -> string {
        return (n < 10 ? "0" : "") + n;
    }
    pure function time(t: float) -> string {
        return floor(t / 3600) > 0
            ? floor(t / 3600) + ":" + pad(mod(floor(t / 60), 60)) + ":" + pad(mod(floor(t), 60))
            : floor(t / 60) + ":" + pad(mod(floor(t), 60));
    }
    function wake() {
        root.controls-shown = true;
        idle.restart();
    }

    idle := Timer {
        interval: 2.5s;
        running: root.controls-shown && !root.pinned;
        triggered => { root.controls-shown = false; }
    }

    // Below the controls: clicking the picture toggles pause, and any pointer
    // movement brings the controls back.
    TouchArea {
        mouse-cursor: root.controls-shown ? MouseCursor.default : MouseCursor.none;
        moved => { root.wake(); }
        clicked => {
            if root.open-menu != "" {
                root.open-menu = "";
            } else {
                root.toggle-pause();
            }
            root.wake();
        }
        double-clicked => { root.toggle-fullscreen(); }
    }

    controls := Rectangle {
        opacity: root.controls-shown ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 180ms; }

        // Top: back, title, wall clock.
        Rectangle {
            y: 0;
            height: 120px;
            background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%);
        }
        HorizontalLayout {
            y: 0;
            height: 96px;
            padding: 16px;
            spacing: 12px;
            alignment: stretch;

            IconButton {
                y: 16px;
                icon: @image-url("icons/arrow-left.svg");
                clicked => { root.back(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 2px;
                padding-top: 6px;
                Text {
                    text: root.title;
                    color: #ffffff;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.subtitle;
                    color: #ffffffb3;
                    font-size: 13px;
                    overflow: elide;
                }
                Text {
                    text: root.stats;
                    color: #ffffff80;
                    font-size: 12px;
                }
            }
            Text {
                text: root.clock;
                color: #ffffffcc;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: top;
                y: 16px;
            }
        }

        // Track / chapter / speed menu, floating above the bar at the right.
        if root.open-menu != "" && root.open-menu != "sleep": Rectangle {
            property <length> list-height: min(menu-list.preferred-height, 360px);
            x: parent.width - self.width - 20px;
            y: parent.height - 108px - self.height;
            width: 320px;
            height: self.list-height;
            border-radius: 12px;
            background: #141518f2;
            border-width: 1px;
            border-color: #ffffff14;
            clip: true;

            // Swallow clicks so they don't reach the picture (pause) behind.
            TouchArea { }

            Flickable {
                content-height: menu-list.preferred-height;
                menu-list := VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    HorizontalLayout {
                        padding-left: 12px;
                        Text {
                            text: root.open-menu == "speed" ? "Playback speed"
                                : root.open-menu == "sub" ? "Subtitles"
                                : root.open-menu == "audio" ? "Audio track"
                                : "Chapters";
                            color: #ffffff99;
                            font-size: 12px;
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                    }
                    if root.open-menu == "speed": VerticalLayout {
                        spacing: 2px;
                        for item in root.speeds: MenuRow {
                            item: item;
                            clicked => { root.pick-speed(item.id); }
                        }
                    }
                    if root.open-menu == "sub": VerticalLayout {
                        spacing: 2px;
                        for item in root.subtitles: MenuRow {
                            item: item;
                            clicked => { root.pick-subtitle(item.id); }
                        }
                    }
                    if root.open-menu == "audio": VerticalLayout {
                        spacing: 2px;
                        for item in root.audio-tracks: MenuRow {
                            item: item;
                            clicked => { root.pick-audio(item.id); }
                        }
                    }
                    if root.open-menu == "chapters": VerticalLayout {
                        spacing: 2px;
                        for item in root.chapters: MenuRow {
                            item: item;
                            clicked => { root.pick-chapter(item.id); }
                        }
                    }
                }
            }
        }

        // Bottom: seek bar, then transport and track/view controls.
        Rectangle {
            y: parent.height - self.height;
            height: 170px;
            background: @linear-gradient(0deg, #000000cc 0%, #00000000 100%);
        }
        VerticalLayout {
            y: parent.height - self.height;
            height: 104px;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 14px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: root.time(seek-bar.dragging ? seek-bar.preview * root.duration : root.position);
                    color: #ffffff;
                    font-size: 13px;
                    vertical-alignment: center;
                    min-width: 44px;
                }
                seek-bar := Scrubber {
                    horizontal-stretch: 1;
                    value: root.duration > 0 ? root.position / root.duration : 0;
                    committed(v) => { root.seek(v * root.duration); }
                }
                Text {
                    text: "-" + root.time(max(0, root.duration - root.position));
                    color: #ffffff;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 52px;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: stretch;

                IconButton {
                    icon: @image-url("icons/skip-back.svg");
                    enabled: root.has-previous;
                    clicked => { root.previous(); }
                }
                IconButton {
                    icon: @image-url("icons/rotate-ccw.svg");
                    clicked => { root.seek-by(-10); }
                }
                IconButton {
                    icon: root.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                    icon-size: 26px;
                    clicked => { root.toggle-pause(); }
                }
                IconButton {
                    icon: @image-url("icons/rotate-cw.svg");
                    clicked => { root.seek-by(10); }
                }
                IconButton {
                    icon: @image-url("icons/skip-forward.svg");
                    enabled: root.has-next;
                    clicked => { root.next(); }
                }
                Text {
                    text: root.ends-at;
                    color: #ffffffcc;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                // Up next: right-aligned in the free space; clicking it skips ahead.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    padding-right: 12px;

                    if root.up-next != "": Rectangle {
                        max-width: 380px;
                        border-radius: 6px;
                        background: up-next-touch.has-hover ? #ffffff1f : transparent;

                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Up next";
                                color: #ffffff99;
                                font-size: 11px;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: root.up-next;
                                color: #ffffff;
                                font-size: 13px;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }
                        up-next-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.next(); }
                        }
                    }
                }

                IconButton {
                    icon: root.muted || root.volume == 0
                        ? @image-url("icons/volume-x.svg")
                        : @image-url("icons/volume-2.svg");
                    clicked => { root.toggle-mute(); }
                }
                volume-bar := Scrubber {
                    width: 96px;
                    y: (38px - self.height) / 2;
                    value: root.muted ? 0 : root.volume / 100;
                    changed(v) => { root.set-volume(v * 100); }
                }
                Rectangle { width: 10px; }
                // Sleep timer: a moon, or the minutes left while counting down.
                if root.sleep-mode == "minutes": Chip {
                    text: root.sleep-badge;
                    selected: false;
                    clicked => { root.toggle-menu("sleep"); }
                }
                if root.sleep-mode != "minutes": IconButton {
                    icon: @image-url("icons/moon.svg");
                    active: root.open-menu == "sleep" || root.sleep-mode != "off";
                    clicked => { root.toggle-menu("sleep"); }
                }

                // Speed: shows the current rate, like the Tauri picker.
                Rectangle {
                    width: max(44px, speed-text.preferred-width + 16px);
                    height: 38px;
                    border-radius: 19px;
                    background: root.open-menu == "speed" ? #ffffff2e : speed-touch.has-hover ? #ffffff1f : transparent;
                    speed-text := Text {
                        text: root.speed-label;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    speed-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-menu("speed"); }
                    }
                }
                if root.subtitles.length > 1: IconButton {
                    icon: @image-url("icons/captions.svg");
                    active: root.open-menu == "sub" || root.subtitles-on;
                    clicked => { root.toggle-menu("sub"); }
                }
                if root.audio-tracks.length > 1: IconButton {
                    icon: @image-url("icons/audio-lines.svg");
                    active: root.open-menu == "audio";
                    clicked => { root.toggle-menu("audio"); }
                }
                if root.chapters.length > 0: IconButton {
                    icon: @image-url("icons/list-video.svg");
                    active: root.open-menu == "chapters";
                    clicked => { root.toggle-menu("chapters"); }
                }
                IconButton {
                    icon: root.fullscreen ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                    clicked => { root.toggle-fullscreen(); }
                }
            }
        }

        // Sleep timer dialog, centred over the dimmed player (as in the Tauri
        // app). Last in the tree so its scrim covers the bars too.
        if root.open-menu == "sleep": Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { root.open-menu = ""; }
            }

            Rectangle {
                width: 340px;
                height: sleep-card.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: #16171b;
                border-width: 1px;
                border-color: #ffffff14;

                TouchArea { }

                sleep-card := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("icons/moon.svg");
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }
                        Text {
                            text: "Sleep timer";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if root.sleep-mode != "off": Text {
                            text: "Turn off";
                            color: off-touch.has-hover ? #ffffff : #ffffffb3;
                            font-size: 13px;
                            vertical-alignment: center;
                            off-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sleep-off(); }
                            }
                        }
                    }

                    if root.sleep-mode == "minutes": Text {
                        text: "Pausing in " + root.sleep-badge + ".";
                        color: #ffffffb3;
                        font-size: 13px;
                    }
                    if root.sleep-mode == "lecture": Text {
                        text: "Pausing at the end of this lecture.";
                        color: #ffffffb3;
                        font-size: 13px;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        for minutes in [15, 30, 45, 60]: Chip {
                            horizontal-stretch: 1;
                            text: minutes + "m";
                            selected: root.sleep-mode == "minutes" && root.sleep-minutes == minutes;
                            clicked => {
                                root.sleep-for(minutes);
                                root.open-menu = "";
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 8px;
                            background: #0e0f12;
                            border-width: 1px;
                            border-color: custom.has-focus ? #ffffff66 : #ffffff1f;

                            custom := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: #ffffff;
                                font-size: 13px;
                                input-type: InputType.number;
                                accepted => {
                                    if self.text.to-float() >= 1 {
                                        root.sleep-for(floor(self.text.to-float()));
                                        self.text = "";
                                        root.open-menu = "";
                                    }
                                }
                            }
                            if custom.text == "": Text {
                                x: 10px;
                                height: parent.height;
                                text: "Custom minutes";
                                color: #ffffff59;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        Chip {
                            text: "Set";
                            clicked => {
                                if custom.text.to-float() >= 1 {
                                    root.sleep-for(floor(custom.text.to-float()));
                                    custom.text = "";
                                    root.open-menu = "";
                                }
                            }
                        }
                    }

                    MenuRow {
                        item: {
                            id: 0,
                            label: "End of lecture",
                            detail: "",
                            selected: root.sleep-mode == "lecture",
                        };
                        clicked => {
                            root.sleep-at-end();
                            root.open-menu = "";
                        }
                    }
                }
            }
        }
    }
}
