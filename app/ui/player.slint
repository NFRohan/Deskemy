// Player overlay. Design language after Plezy's player view: controls sit
// directly on the video, monochrome, no panels — only soft scrims top and
// bottom for legibility — with a thin seek bar and "Ends at" time.

import { Nav, TitleBar, WindowChrome } from "shell.slint";
import { Library } from "library.slint";

/// One entry in a track / chapter / speed menu.
export struct MenuItem {
    id: int,
    label: string,
    /// Secondary text before the label (a chapter's start time).
    detail: string,
    selected: bool,
}

/// Playback info (I): labelled values in titled groups, three groups a row.
export struct StatLine {
    label: string,
    value: string,
}

export struct StatGroup {
    title: string,
    lines: [StatLine],
}

export struct StatRow {
    groups: [StatGroup],
}

export struct Shortcut {
    keys: string,
    action: string,
}

export struct ShortcutGroup {
    title: string,
    items: [Shortcut],
}

/// A lecture in the course panel.
export struct ResourceItem {
    id: string,
    name: string,
    /// pdf / archive / code / html / text, or "".
    kind: string,
    path: string,
    /// Marked done.
    done: bool,
}

export struct LectureRow {
    id: string,
    title: string,
    /// `m:ss`, or "" when unknown.
    duration: string,
    completed: bool,
    playable: bool,
    current: bool,
    /// Its resources, shown under it (with "keep videos and resources together").
    resources: [ResourceItem],
}

/// A section in the course panel, with its lectures.
export struct SectionRow {
    id: string,
    title: string,
    /// "done/total".
    progress: string,
    expanded: bool,
    lectures: [LectureRow],
}


/// Resources of one lecture (or the section itself) in the current section.
export struct ResourceGroup {
    title: string,
    items: [ResourceItem],
}

/// A saved bookmark in the playing lecture.
export struct BookmarkRow {
    id: string,
    /// Position as `m:ss`.
    time: string,
    label: string,
    position: float,
}

/// Playback state pushed from Rust, and the user's actions sent back to it.
export global Playback {
    in property <string> title;
    in property <string> subtitle;
    /// The playing lecture's course ("" for a bare file).
    in property <string> course-title;
    in property <string> course-id;
    in property <[StatRow]> stats;
    in property <bool> stats-open;
    in property <string> clock;
    in property <string> ends-at;
    in property <string> up-next;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume: 100;
    in property <bool> muted;
    in property <bool> fullscreen;
    /// The follow-along mini player: the window small and on top (Rust
    /// resizes it; see mini.rs).
    in-out property <bool> mini;
    /// The app moves the mini player itself while it's dragged (Windows: no
    /// Snap); elsewhere the window system's own move does.
    in property <bool> mini-native-drag;
    /// Settings' "Auto-hide controls in fullscreen".
    in property <bool> autohide-fullscreen;
    in property <bool> has-previous;
    in property <bool> has-next;
    in property <string> speed-label: "1×";
    in property <bool> subtitles-on;
    in property <[MenuItem]> speeds;
    in property <[MenuItem]> subtitles;
    in property <[MenuItem]> audio-tracks;
    in property <[MenuItem]> chapters;
    /// Which overlay menu is open ("" = none); two-way bound to the overlay.
    in-out property <string> open-menu;
    /// Sleep timer: "off", "minutes" or "lecture"; the badge is e.g. "27m".
    in property <string> sleep-mode: "off";
    in property <string> sleep-badge;
    in property <int> sleep-minutes;
    /// Whether the playing file is a library lecture (bookmarks need one).
    in property <bool> in-library;
    /// This course plays at its own speed: the default's label ("1.25×") for
    /// the speed menu's "Use default"; empty when the default applies.
    in property <string> speed-default;
    /// The moment being bookmarked, and the lecture's saved bookmarks.
    in property <string> bookmark-time;
    in property <[BookmarkRow]> bookmarks;
    /// Course panel: open, which tab ("content" / "resources"), and contents.
    in-out property <bool> panel-open;
    in-out property <string> panel-tab: "content";
    in property <[SectionRow]> panel-sections;
    in property <[ResourceGroup]> panel-resources;
    in property <string> resources-section;
    in property <int> resources-count;

    callback back();
    callback toggle-pause();
    callback seek(float);
    callback seek-by(float);
    callback previous();
    callback next();
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-fullscreen();
    callback toggle-mini();
    /// Dragging the mini player: pressed on it, then each pointer move.
    callback mini-drag-start();
    callback mini-drag-move();
    /// Leave the mini player because the player is closing (not back to
    /// fullscreen).
    callback leave-mini();
    /// The controls faded (true) or came back: hide / show the pointer.
    callback cursor-hidden(bool);
    callback pick-speed(int);
    callback pick-subtitle(int);
    callback pick-audio(int);
    callback pick-chapter(int);
    callback sleep-for(int);
    callback sleep-at-end();
    callback sleep-off();
    callback open-bookmark();
    callback save-bookmark(string);
    callback close-bookmark();
    callback jump-to-bookmark(float);
    callback delete-bookmark(string);
    /// C: subtitles off, or on with the first track.
    callback toggle-subtitles();
    /// < / >: previous / next preset speed.
    callback step-speed(int);
    /// Drop the course's own speed for the default.
    callback use-default-speed();
    /// I: show / hide the playback-info overlay.
    callback toggle-stats();
    /// Rebuild the panel's contents (on opening it, or a lecture change).
    callback refresh-panel();
    callback toggle-section(string);
    callback open-lecture(string);
    callback open-resource(string);
    /// Mark a resource done (true) or not.
    callback toggle-resource(string, bool);
    /// The ended lecture's resources, when autoplay stopped at them.
    in property <[ResourceItem]> prompt-items;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 22px;
    in property <bool> enabled: true;
    /// Highlighted while its menu is open or its feature is on.
    in property <bool> active;
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: self.width / 2;
    background: root.active ? #ffffff2e : touch.has-hover && root.enabled ? #ffffff1f : transparent;

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? #ffffff4d : touch.pressed ? #ffffffb3 : #ffffff;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A thin scrubbable track; `value` is 0..1. `changed` fires continuously while
// dragging, `committed` once on release (seeking commits, volume follows live).
export component Scrubber inherits Rectangle {
    in property <float> value;
    out property <float> preview;
    out property <bool> dragging: touch.pressed;
    callback changed(float);
    callback committed(float);
    /// Track height at rest (two pixels thicker under the pointer).
    in property <length> thickness: 3px;
    in property <length> thumb: 13px;

    property <float> shown: max(0, min(1, touch.pressed ? root.preview : root.value));
    property <length> track: touch.has-hover || touch.pressed ? root.thickness + 2px : root.thickness;

    height: 20px;

    Rectangle {
        y: (parent.height - root.track) / 2;
        width: parent.width;
        height: root.track;
        border-radius: root.track / 2;
        background: #ffffff40;

        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: parent.height;
            border-radius: parent.border-radius;
            background: #ffffff;
        }
    }

    if touch.has-hover || touch.pressed: Rectangle {
        x: root.width * root.shown - self.width / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: self.width / 2;
        background: #ffffff;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.preview = max(0, min(1, self.mouse-x / root.width));
                    root.changed(root.preview);
                } else if event.kind == PointerEventKind.up {
                    root.committed(root.preview);
                }
            }
        }
        moved => {
            if self.pressed {
                root.preview = max(0, min(1, self.mouse-x / root.width));
                root.changed(root.preview);
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    min-width: 56px;
    // Room either side of the label, so longer ones ("Next lecture") breathe.
    preferred-width: max(56px, label.preferred-width + 28px);
    border-radius: 8px;
    background: root.selected ? #ffffff : touch.has-hover ? #ffffff2e : #ffffff1a;

    label := Text {
        text: root.text;
        color: root.selected ? #000000 : #ffffff;
        font-size: 13px;
        font-weight: 600;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuRow inherits Rectangle {
    in property <MenuItem> item;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? #ffffff1a : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        if root.item.detail != "": Text {
            text: root.item.detail;
            color: #ffffff99;
            font-size: 12px;
            vertical-alignment: center;
            min-width: 52px;
        }
        Text {
            text: root.item.label;
            color: #ffffff;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Image {
            source: @image-url("icons/check.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: #ffffff;
            opacity: root.item.selected ? 1 : 0;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The player overlay. Reads and drives the `Playback` global directly.
export component PlayerOverlay inherits Rectangle {
    in-out property <bool> controls-shown: true;
    // Never auto-hide mid-drag or with a menu open; nor, while the pointer is
    // in the window, when paused or while it rests on the controls. Once it
    // leaves the window they tuck away regardless.
    property <bool> pinned: seek-bar.dragging || volume-bar.dragging || Playback.open-menu != ""
        || (hover-area.has-hover && (Playback.paused || !picture.has-hover));
    // In a window the controls always tuck away (they sit over the video); in
    // fullscreen only with the setting on, as the Tauri player.
    property <bool> may-hide: !Playback.fullscreen || Playback.autohide-fullscreen;
    // The end-of-lecture resources card brings them (and the pointer) back.
    property <bool> shown: root.controls-shown || !root.may-hide || Playback.open-menu == "exercise";
    // The pointer goes with the controls. `mouse-cursor` alone isn't enough:
    // Slint applies it on the next mouse event, and they fade while it's still.
    changed shown => { Playback.cursor-hidden(!root.shown); }

    function toggle-menu(name: string) {
        Playback.open-menu = Playback.open-menu == name ? "" : name;
    }

    pure function pad(n: float) -> string {
        return (n < 10 ? "0" : "") + n;
    }
    pure function time(t: float) -> string {
        return floor(t / 3600) > 0
            ? floor(t / 3600) + ":" + pad(mod(floor(t / 60), 60)) + ":" + pad(mod(floor(t), 60))
            : floor(t / 60) + ":" + pad(mod(floor(t), 60));
    }
    function wake() {
        root.controls-shown = true;
        // `restart()` re-arms a stopped Timer whatever `running` says, so only
        // when it may run: moving the pointer while typing a bookmark (or with
        // any menu open) would otherwise hide the controls, and the menu with them.
        if root.may-hide && !root.pinned {
            idle.restart();
        }
    }

    /// The Tauri player's shortcut map.
    out property <[ShortcutGroup]> shortcuts: [
        {
            title: "Playback",
            items: [
                { keys: "Space / K", action: "Play / pause" },
                { keys: "J / L", action: "Back / forward 10s" },
                { keys: "← / →", action: "Back / forward 5s" },
                { keys: "↑ / ↓", action: "Volume up / down" },
                { keys: "M", action: "Mute" },
                { keys: "C", action: "Toggle subtitles" },
                { keys: "< / >", action: "Speed down / up" },
                { keys: "0 – 9", action: "Jump to 0–90%" },
                { keys: "Home / End", action: "Start / end" },
            ],
        },
        {
            title: "Navigation",
            items: [
                { keys: "N / ⇧N", action: "Next / previous lecture" },
                { keys: "F", action: "Fullscreen" },
                { keys: "T", action: "Mini player, on top" },
                { keys: "Esc", action: "Exit / back" },
                { keys: "Mouse back", action: "Leave the player" },
            ],
        },
        {
            title: "Panels",
            items: [
                { keys: "P", action: "Course content" },
                { keys: "R", action: "Resources" },
                { keys: "B", action: "Bookmark here" },
                { keys: "I", action: "Playback info" },
                { keys: "?", action: "This cheat sheet" },
            ],
        },
    ];

    /// P / R: open the panel on that tab — or close it if that tab is showing.
    function show-panel(tab: string) {
        if Playback.panel-open && Playback.panel-tab == tab {
            Playback.panel-open = false;
            return;
        }
        Playback.panel-tab = tab;
        if !Playback.panel-open {
            Playback.panel-open = true;
            Playback.refresh-panel();
        }
    }

    function toggle-panel() {
        if Playback.panel-open {
            Playback.panel-open = false;
        } else {
            root.show-panel("content");
        }
    }

    /// Esc peels back one layer at a time: an open dialog or menu, then
    /// fullscreen, then leave the player.
    function escape() {
        if Playback.open-menu == "bookmark" {
            Playback.close-bookmark();
        } else if Playback.open-menu != "" {
            Playback.open-menu = "";
        } else if Playback.fullscreen {
            Playback.toggle-fullscreen();
        } else {
            Playback.back();
        }
    }

    function key(event: KeyEvent) -> EventResult {
        // Leave system / editing chords alone.
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
            return reject;
        }
        if event.text == Key.Escape {
            root.escape();
            return accept;
        }
        // While the bookmark dialog is open, keys are for its label, never
        // shortcuts (Space would resume the video underneath).
        if Playback.open-menu == "bookmark" {
            return accept;
        }
        if event.text == " " || event.text == "k" {
            Playback.toggle-pause();
        } else if event.text == "j" {
            Playback.seek-by(-10);
        } else if event.text == "l" {
            Playback.seek-by(10);
        } else if event.text == Key.LeftArrow {
            Playback.seek-by(-5);
        } else if event.text == Key.RightArrow {
            Playback.seek-by(5);
        } else if event.text == Key.UpArrow {
            Playback.set-volume(min(100, (Playback.muted ? 0 : Playback.volume) + 5));
        } else if event.text == Key.DownArrow {
            if !Playback.muted {
                Playback.set-volume(max(0, Playback.volume - 5));
            }
        } else if event.text == "m" {
            Playback.toggle-mute();
        } else if event.text == "f" {
            Playback.toggle-fullscreen();
        } else if event.text == "t" {
            Playback.toggle-mini();
        } else if event.text == "c" {
            Playback.toggle-subtitles();
        } else if event.text == "," || event.text == "<" {
            Playback.step-speed(-1);
        } else if event.text == "." || event.text == ">" {
            Playback.step-speed(1);
        } else if event.text == Key.Home {
            Playback.seek(0);
        } else if event.text == Key.End {
            Playback.seek(Playback.duration * 0.999);
        } else if event.text == "b" {
            if Playback.in-library {
                Playback.open-bookmark();
            }
        } else if event.text == "n" {
            Playback.next();
        } else if event.text == "N" {
            Playback.previous();
        } else if event.text == "p" {
            root.show-panel("content");
        } else if event.text == "r" {
            root.show-panel("resources");
        } else if event.text == "i" {
            Playback.toggle-stats();
        } else if event.text == "?" {
            root.toggle-menu("shortcuts");
        } else if event.text.is-float() {
            // A single digit: jump to that tenth of the lecture.
            Playback.seek(Playback.duration * event.text.to-float() / 10);
        } else {
            return reject;
        }
        root.wake();
        return accept;
    }

    // Closing a dialog destroys whatever had focus (e.g. the bookmark label),
    // so hand it back to the shortcut scope.
    property <string> menu: Playback.open-menu;
    changed menu => {
        // Not when the mini player is taking over (entering it closes the
        // menu): focus would go to this overlay as it's removed, and the
        // mini player's keys (T) would reach nothing.
        if root.menu == "" && !Playback.mini {
            keys.focus();
        }
    }

    idle := Timer {
        interval: 2.5s;
        running: root.controls-shown && root.may-hide && !root.pinned;
        triggered => {
            // In case it was re-armed anyway: never hide over an open menu.
            if root.may-hide && !root.pinned {
                root.controls-shown = false;
            }
        }
    }

    // Wraps the whole overlay: keys typed into a field inside (the bookmark
    // label) stay there, while ones it rejects (Esc) bubble up to here.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => { return root.key(event); }

        // Sees every pointer move over the overlay — its children included —
        // and loses hover when the pointer leaves the window.
        hover-area := TouchArea {
        mouse-cursor: root.shown ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => { root.wake(); }
        changed mouse-y => { root.wake(); }

        // Below the controls. A click on the picture only closes an open menu
        // — it doesn't pause, so a double-click (fullscreen) can't also
        // toggle pause twice. (Pointer movement anywhere wakes the controls —
        // see `hover-area`.)
        picture := TouchArea {
            mouse-cursor: root.shown ? MouseCursor.default : MouseCursor.none;
            moved => { root.wake(); }
            clicked => {
                if Playback.open-menu != "" {
                    Playback.open-menu = "";
                }
                root.wake();
            }
            // The mouse's back button leaves the player (as the browser's did
            // in the Tauri app) — after closing an open menu or dialog.
            pointer-event(event) => {
                if event.button == PointerEventButton.back && event.kind == PointerEventKind.up {
                    if Playback.open-menu == "bookmark" {
                        Playback.close-bookmark();
                    } else if Playback.open-menu != "" {
                        Playback.open-menu = "";
                    } else {
                        Playback.back();
                    }
                }
            }
            double-clicked => { Playback.toggle-fullscreen(); }
        }

        controls := Rectangle {
            opacity: root.shown ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 180ms; }

            // Fullscreen: back, title and the wall clock over the picture (in a
            // window the title bar above the video has the way back).
            if Playback.fullscreen: Rectangle {
                y: 0;
                height: 120px;
                background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%);
            }
            if Playback.fullscreen: HorizontalLayout {
                y: 0;
                height: 72px;
                padding-left: 16px;
                padding-right: 20px;
                padding-top: 12px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/arrow-left.svg");
                        clicked => { Playback.back(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Playback.title;
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: Playback.subtitle;
                        color: #ffffffb3;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
                Text {
                    text: Playback.clock;
                    color: #ffffffcc;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Dark enough behind the white controls to read over bright frames.
            // Before the menus, so it shades the picture and not them.
            Rectangle {
                y: parent.height - self.height;
                height: 190px;
                background: @linear-gradient(0deg, #000000e6 0%, #000000a6 45%, #00000000 100%);
            }

            // Track / chapter / speed menu, floating above the bar at the right.
            if Playback.open-menu == "speed" || Playback.open-menu == "sub"
                || Playback.open-menu == "audio" || Playback.open-menu == "chapters": Rectangle {
                // Scrolls past 420px, or past the room above the bar in a small window.
                property <length> list-height: min(menu-list.preferred-height, min(420px, parent.height - 140px));
                x: parent.width - self.width - 20px;
                y: parent.height - 108px - self.height;
                width: 320px;
                height: self.list-height;
                border-radius: 12px;
                background: #141518f2;
                border-width: 1px;
                border-color: #ffffff14;
                clip: true;

                // Swallow clicks so they don't reach the picture behind (closing the menu).
                TouchArea { }

                Flickable {
                    content-height: menu-list.preferred-height;
                    menu-list := VerticalLayout {
                        padding: 8px;
                        spacing: 2px;

                        HorizontalLayout {
                            padding-left: 12px;
                            Text {
                                text: Playback.open-menu == "speed" ? "Playback speed"
                                    : Playback.open-menu == "sub" ? "Subtitles"
                                    : Playback.open-menu == "audio" ? "Audio track"
                                    : "Chapters";
                                color: #ffffff99;
                                font-size: 12px;
                                font-weight: 600;
                                height: 28px;
                                vertical-alignment: center;
                            }
                        }
                        if Playback.open-menu == "speed": VerticalLayout {
                            spacing: 2px;
                            for item in Playback.speeds: MenuRow {
                                item: item;
                                clicked => { Playback.pick-speed(item.id); }
                            }
                            // The course has its own speed (picked here);
                            // Settings' default applies again from this row.
                            if Playback.speed-default != "": VerticalLayout {
                                spacing: 2px;
                                Rectangle {
                                    height: 9px;
                                    Rectangle {
                                        height: 1px;
                                        background: #ffffff1f;
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    Text {
                                        text: "Saved for this course";
                                        color: #ffffff99;
                                        font-size: 12px;
                                        height: 24px;
                                        vertical-alignment: center;
                                    }
                                }
                                MenuRow {
                                    item: { id: -1, label: "Use default (" + Playback.speed-default + ")", detail: "", selected: false };
                                    clicked => { Playback.use-default-speed(); }
                                }
                            }
                        }
                        if Playback.open-menu == "sub": VerticalLayout {
                            spacing: 2px;
                            for item in Playback.subtitles: MenuRow {
                                item: item;
                                clicked => { Playback.pick-subtitle(item.id); }
                            }
                        }
                        if Playback.open-menu == "audio": VerticalLayout {
                            spacing: 2px;
                            for item in Playback.audio-tracks: MenuRow {
                                item: item;
                                clicked => { Playback.pick-audio(item.id); }
                            }
                        }
                        if Playback.open-menu == "chapters": VerticalLayout {
                            spacing: 2px;
                            for item in Playback.chapters: MenuRow {
                                item: item;
                                clicked => { Playback.pick-chapter(item.id); }
                            }
                        }
                    }
                }
            }

            // Bottom: seek bar, then transport and track/view controls.
            VerticalLayout {
                y: parent.height - self.height;
                height: 104px;
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 14px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 14px;
                    Text {
                        text: root.time(seek-bar.dragging ? seek-bar.preview * Playback.duration : Playback.position);
                        color: #ffffff;
                        font-size: 13px;
                        vertical-alignment: center;
                        min-width: 44px;
                    }
                    seek-bar := Scrubber {
                        horizontal-stretch: 1;
                        thickness: 6px;
                        thumb: 16px;
                        value: Playback.duration > 0 ? Playback.position / Playback.duration : 0;
                        committed(v) => { Playback.seek(v * Playback.duration); }
                    }
                    Text {
                        text: "-" + root.time(max(0, Playback.duration - Playback.position));
                        color: #ffffff;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 52px;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: stretch;

                    IconButton {
                        icon: @image-url("icons/m-skip-previous.svg");
                        enabled: Playback.has-previous;
                        clicked => { Playback.previous(); }
                    }
                    IconButton {
                        icon: @image-url("icons/m-replay-10.svg");
                        clicked => { Playback.seek-by(-10); }
                    }
                    IconButton {
                        icon: Playback.paused ? @image-url("icons/m-play-arrow.svg") : @image-url("icons/m-pause.svg");
                        icon-size: 26px;
                        clicked => { Playback.toggle-pause(); }
                    }
                    IconButton {
                        icon: @image-url("icons/m-forward-10.svg");
                        clicked => { Playback.seek-by(10); }
                    }
                    IconButton {
                        icon: @image-url("icons/m-skip-next.svg");
                        enabled: Playback.has-next;
                        clicked => { Playback.next(); }
                    }
                    Text {
                        text: Playback.ends-at;
                        color: #ffffffcc;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    // Up next: right-aligned in the free space; clicking it skips ahead.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        padding-right: 12px;

                        if Playback.up-next != "": Rectangle {
                            max-width: 380px;
                            border-radius: 6px;
                            background: up-next-touch.has-hover ? #ffffff1f : transparent;

                            VerticalLayout {
                                alignment: center;
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "Up next";
                                    color: #ffffff99;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: Playback.up-next;
                                    color: #ffffff;
                                    font-size: 13px;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                            }
                            up-next-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Playback.next(); }
                            }
                        }
                    }

                    IconButton {
                        icon: Playback.muted || Playback.volume == 0
                            ? @image-url("icons/m-volume-off.svg")
                            : @image-url("icons/m-volume-up.svg");
                        clicked => { Playback.toggle-mute(); }
                    }
                    volume-bar := Scrubber {
                        width: 96px;
                        y: (38px - self.height) / 2;
                        value: Playback.muted ? 0 : Playback.volume / 100;
                        changed(v) => { Playback.set-volume(v * 100); }
                    }
                    Rectangle { width: 10px; }
                    if Playback.in-library: IconButton {
                        icon: @image-url("icons/m-bookmark-add.svg");
                        active: Playback.open-menu == "bookmark";
                        clicked => { Playback.open-bookmark(); }
                    }
                    if Playback.chapters.length > 0: IconButton {
                        icon: @image-url("icons/m-format-list-bulleted.svg");
                        active: Playback.open-menu == "chapters";
                        clicked => { root.toggle-menu("chapters"); }
                    }
                    if Playback.audio-tracks.length > 1: IconButton {
                        icon: @image-url("icons/m-music-note.svg");
                        active: Playback.open-menu == "audio";
                        clicked => { root.toggle-menu("audio"); }
                    }
                    if Playback.subtitles.length > 1: IconButton {
                        icon: @image-url("icons/m-subtitles.svg");
                        active: Playback.open-menu == "sub" || Playback.subtitles-on;
                        clicked => { root.toggle-menu("sub"); }
                    }
                    // Sleep timer: a moon, or the minutes left while counting down.
                    if Playback.sleep-mode == "minutes": Chip {
                        text: Playback.sleep-badge;
                        selected: false;
                        clicked => { root.toggle-menu("sleep"); }
                    }
                    if Playback.sleep-mode != "minutes": IconButton {
                        icon: @image-url("icons/m-bedtime.svg");
                        active: Playback.open-menu == "sleep" || Playback.sleep-mode != "off";
                        clicked => { root.toggle-menu("sleep"); }
                    }

                    // Speed: shows the current rate, like the Tauri picker.
                    Rectangle {
                        width: max(44px, speed-text.preferred-width + 16px);
                        height: 38px;
                        border-radius: 19px;
                        background: Playback.open-menu == "speed" ? #ffffff2e : speed-touch.has-hover ? #ffffff1f : transparent;
                        speed-text := Text {
                            text: Playback.speed-label;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        speed-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-menu("speed"); }
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/m-keyboard.svg");
                        active: Playback.open-menu == "shortcuts";
                        clicked => { root.toggle-menu("shortcuts"); }
                    }
                    if Playback.in-library: IconButton {
                        icon: @image-url("icons/m-view-sidebar.svg");
                        active: Playback.panel-open;
                        clicked => { root.toggle-panel(); }
                    }
                    IconButton {
                        icon: @image-url("icons/m-picture-in-picture.svg");
                        clicked => { Playback.toggle-mini(); }
                    }
                    IconButton {
                        icon: Playback.fullscreen ? @image-url("icons/m-fullscreen-exit.svg") : @image-url("icons/m-fullscreen.svg");
                        clicked => { Playback.toggle-fullscreen(); }
                    }
                }
            }

            // Sleep timer dialog, centred over the dimmed player (as in the Tauri
            // app). Last in the tree so its scrim covers the bars too.
            if Playback.open-menu == "sleep": Rectangle {
                background: #00000099;
                TouchArea {
                    clicked => { Playback.open-menu = ""; }
                }

                Rectangle {
                    width: 340px;
                    height: sleep-card.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    background: #16171b;
                    border-width: 1px;
                    border-color: #ffffff14;

                    TouchArea { }

                    sleep-card := VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 8px;
                            Image {
                                source: @image-url("icons/m-bedtime.svg");
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                                colorize: #ffffff;
                            }
                            Text {
                                text: "Sleep timer";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if Playback.sleep-mode != "off": Text {
                                text: "Turn off";
                                color: off-touch.has-hover ? #ffffff : #ffffffb3;
                                font-size: 13px;
                                vertical-alignment: center;
                                off-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Playback.sleep-off(); }
                                }
                            }
                        }

                        if Playback.sleep-mode == "minutes": Text {
                            text: "Pausing in " + Playback.sleep-badge + ".";
                            color: #ffffffb3;
                            font-size: 13px;
                        }
                        if Playback.sleep-mode == "lecture": Text {
                            text: "Pausing at the end of this lecture.";
                            color: #ffffffb3;
                            font-size: 13px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            for minutes in [15, 30, 45, 60]: Chip {
                                horizontal-stretch: 1;
                                text: minutes + "m";
                                selected: Playback.sleep-mode == "minutes" && Playback.sleep-minutes == minutes;
                                clicked => {
                                    Playback.sleep-for(minutes);
                                    Playback.open-menu = "";
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 36px;
                                border-radius: 8px;
                                background: #0e0f12;
                                border-width: 1px;
                                border-color: custom.has-focus ? #ffffff66 : #ffffff1f;

                                custom := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    color: #ffffff;
                                    font-size: 13px;
                                    input-type: InputType.number;
                                    accepted => {
                                        if self.text.to-float() >= 1 {
                                            Playback.sleep-for(floor(self.text.to-float()));
                                            self.text = "";
                                            Playback.open-menu = "";
                                        }
                                    }
                                }
                                if custom.text == "": Text {
                                    x: 10px;
                                    height: parent.height;
                                    text: "Custom minutes";
                                    color: #ffffff59;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                            Chip {
                                text: "Set";
                                clicked => {
                                    if custom.text.to-float() >= 1 {
                                        Playback.sleep-for(floor(custom.text.to-float()));
                                        custom.text = "";
                                        Playback.open-menu = "";
                                    }
                                }
                            }
                        }

                        MenuRow {
                            item: {
                                id: 0,
                                label: "End of lecture",
                                detail: "",
                                selected: Playback.sleep-mode == "lecture",
                            };
                            clicked => {
                                Playback.sleep-at-end();
                                Playback.open-menu = "";
                            }
                        }
                    }
                }
            }

            // Add-bookmark dialog. Opening it paused the video, so the moment
            // holds while a label is typed; closing resumes if it was playing.
            if Playback.open-menu == "bookmark": Rectangle {
                background: #00000099;
                TouchArea {
                    clicked => { Playback.close-bookmark(); }
                }

                Rectangle {
                    width: 380px;
                    height: bookmark-card.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    background: #16171b;
                    border-width: 1px;
                    border-color: #ffffff14;

                    // A click anywhere on the card goes back to the label, so
                    // typing keeps landing there.
                    TouchArea {
                        clicked => { label.focus(); }
                    }

                    bookmark-card := VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 8px;
                            Image {
                                source: @image-url("icons/bookmark-plus.svg");
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                                colorize: #ffffff;
                            }
                            Text {
                                text: "Add bookmark";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: Playback.bookmark-time;
                                color: #ffffffb3;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: #0e0f12;
                            border-width: 1px;
                            border-color: label.has-focus ? #ffffff66 : #ffffff1f;

                            label := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: #ffffff;
                                font-size: 13px;
                                single-line: true;
                                init => { self.focus(); }
                                accepted => { Playback.save-bookmark(self.text); }
                            }
                            if label.text == "": Text {
                                x: 10px;
                                height: parent.height;
                                text: "Label (optional)";
                                color: #ffffff59;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Chip {
                                text: "Cancel";
                                clicked => { Playback.close-bookmark(); }
                            }
                            Chip {
                                text: "Save";
                                selected: true;
                                clicked => { Playback.save-bookmark(label.text); }
                            }
                        }

                        if Playback.bookmarks.length > 0: VerticalLayout {
                            spacing: 2px;
                            Rectangle {
                                height: 1px;
                                background: #ffffff14;
                            }
                            Text {
                                text: "SAVED BOOKMARKS";
                                color: #ffffff80;
                                font-size: 11px;
                                font-weight: 600;
                                height: 28px;
                                vertical-alignment: center;
                            }
                            Flickable {
                                height: min(saved.preferred-height, 220px);
                                content-height: saved.preferred-height;
                                saved := VerticalLayout {
                                    spacing: 2px;
                                    for mark in Playback.bookmarks: Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        background: mark-touch.has-hover ? #ffffff1a : transparent;

                                        mark-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { Playback.jump-to-bookmark(mark.position); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            spacing: 10px;
                                            Text {
                                                text: mark.time;
                                                color: #ffffff99;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                min-width: 52px;
                                            }
                                            Text {
                                                text: mark.label;
                                                color: #ffffff;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            IconButton {
                                                icon: @image-url("icons/trash-2.svg");
                                                icon-size: 16px;
                                                width: 32px;
                                                height: 32px;
                                                y: 2px;
                                                clicked => {
                                                    Playback.delete-bookmark(mark.id);
                                                    label.focus();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Playback info (I), under the header. Outside the fading controls, so
        // it stays up while watching.
        if Playback.stats-open: Rectangle {
            x: 16px;
            y: 92px;
            width: stats-grid.preferred-width;
            height: stats-grid.preferred-height;
            border-radius: 10px;
            background: #000000a6;

            stats-grid := VerticalLayout {
                padding: 14px;
                spacing: 12px;
                for row in Playback.stats: HorizontalLayout {
                    spacing: 22px;
                    alignment: start;
                    for group in row.groups: VerticalLayout {
                        spacing: 2px;
                        alignment: start;
                        min-width: 120px;
                        Text {
                            text: group.title;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        for line in group.lines: HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            Text {
                                text: line.label + ":";
                                color: #ffffff99;
                                font-size: 11px;
                            }
                            Text {
                                text: line.value;
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                    }
                }
            }
        }

        // Keyboard cheat sheet (?), drawn over everything else, dimmed.
        if Playback.open-menu == "shortcuts": Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { Playback.open-menu = ""; }
            }

            Rectangle {
                width: min(760px, parent.width - 48px);
                height: sheet.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: #16171b;
                border-width: 1px;
                border-color: #ffffff14;

                TouchArea { }

                sheet := VerticalLayout {
                    padding: 22px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("icons/keyboard.svg");
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }
                        Text {
                            text: "Keyboard shortcuts";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 28px;
                        for group in root.shortcuts: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: group.title;
                                color: #ffffff80;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            for shortcut in group.items: HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 88px;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: #ffffff14;
                                    Text {
                                        text: shortcut.keys;
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                }
                                Text {
                                    text: shortcut.action;
                                    color: #ffffffcc;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // End of a lecture with resources ("Pause on exercises and
        // resources"): open them, or go on. Outside the controls, so it
        // stays up when they hide; a click off it or either button closes it.
        if Playback.open-menu == "exercise": Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { Playback.open-menu = ""; }
            }

            Rectangle {
                width: 440px;
                height: exercise-card.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: #16171b;
                border-width: 1px;
                border-color: #ffffff14;

                TouchArea { }

                exercise-card := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("icons/file-text.svg");
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }
                        Text {
                            text: "Before the next lecture";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    // max-width: wrapped text is measured at its one-line width.
                    Text {
                        text: "\u{201C}" + Playback.title + "\u{201D} comes with "
                            + (Playback.prompt-items.length == 1 ? "a resource" : Playback.prompt-items.length + " resources")
                            + ". Open, then tick off, what you've worked through.";
                        color: #ffffffb3;
                        font-size: 13px;
                        wrap: word-wrap;
                        max-width: 400px;
                        // A long unbroken name (underscores, no spaces) breaks anywhere
                        // instead of widening the layout past its card.
                        min-width: 0px;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        for item in Playback.prompt-items: Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: row-touch.has-hover ? #ffffff14 : #ffffff08;
                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Playback.open-resource(item.path); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 16px;
                                    accessible-role: button;
                                    accessible-label: item.done ? "Mark as not done" : "Mark as done";
                                    Image {
                                        source: item.done ? @image-url("icons/circle-check.svg") : @image-url("icons/circle.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: item.done ? #ffffffcc : tick-touch.has-hover ? #ffffffb3 : #ffffff4d;
                                    }
                                    tick-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { Playback.toggle-resource(item.id, !item.done); }
                                    }
                                }
                                Image {
                                    source: @image-url("icons/file-text.svg");
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: #ffffffb3;
                                }
                                Text {
                                    text: item.name;
                                    color: item.done ? #ffffff99 : #ffffffdd;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: "Open";
                                    color: #ffffffb3;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Chip {
                            text: "Stay here";
                            clicked => { Playback.open-menu = ""; }
                        }
                        Chip {
                            text: "Next lecture";
                            selected: true;
                            clicked => {
                                Playback.open-menu = "";
                                Playback.next();
                            }
                        }
                    }
                }
            }
        }
        }
    }
}

/// The title bar above the video in a window, as the Tauri player: where the
/// lecture sits, with links back to the library and its course.
export component PlayerTopBar inherits TitleBar {
    crumbs: Playback.course-id == "" ? ["Library", Playback.title] : ["Library", Playback.course-title, Playback.title];
    targets: Playback.course-id == "" ? ["library", ""] : ["library", "course", ""];
    back-button: true;
    back => { Playback.back(); }
    picked(i) => {
        Playback.back();
        if i == 0 {
            Nav.page = "library";
            Nav.crumbs = ["Library"];
            Nav.crumb-targets = [""];
        } else {
            Library.show-course(Playback.course-id);
        }
    }
}
