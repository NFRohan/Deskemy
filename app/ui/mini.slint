// The follow-along mini player's overlay (see mini.rs): the window small and
// on top, beside an editor or terminal. Controls show while the pointer is
// over it, leaving the picture clear otherwise; drag anywhere to move it,
// double-click (or T, Esc, mouse back) to go back to the full player, close
// to leave the player (the full window comes back where it was).

import { Playback, IconButton, Scrubber } from "player.slint";

/// The picture: double-click (or mouse back) for the full player, a click
/// takes the keys, and with `native-drag` a drag moves the window.
component Picture inherits TouchArea {
    in property <bool> native-drag;
    callback focus-keys();

    double-clicked => { Playback.toggle-mini(); }
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.focus-keys();
            if root.native-drag && event.button == PointerEventButton.left {
                Playback.mini-drag-start();
            }
        }
        if event.button == PointerEventButton.back && event.kind == PointerEventKind.up {
            Playback.toggle-mini();
        }
    }
    moved => {
        if root.native-drag && self.pressed {
            Playback.mini-drag-move();
        }
    }
}

export component MiniPlayer inherits Rectangle {
    property <bool> shown: hover.has-hover || seek.dragging;
    property <float> progress: Playback.duration > 0 ? Playback.position / Playback.duration : 0;

    // Take the keys once the switch has settled too: the full player's
    // closing menus could otherwise leave focus nowhere.
    Timer {
        interval: 100ms;
        running: true;
        triggered => {
            keys.focus();
            self.running = false;
        }
    }

    keys := FocusScope {
        init => {
            // The full player may have hidden the pointer; the mini one never does.
            Playback.cursor-hidden(false);
            self.focus();
        }
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.Escape || event.text == "t" {
                Playback.toggle-mini();
            } else if event.text == " " || event.text == "k" {
                Playback.toggle-pause();
            } else if event.text == "j" {
                Playback.seek-by(-10);
            } else if event.text == "l" {
                Playback.seek-by(10);
            } else if event.text == Key.LeftArrow {
                Playback.seek-by(-5);
            } else if event.text == Key.RightArrow {
                Playback.seek-by(5);
            } else if event.text == "m" {
                Playback.toggle-mute();
            } else if event.text == "n" {
                Playback.next();
            } else if event.text == "N" {
                Playback.previous();
            } else {
                return reject;
            }
            return accept;
        }

        // Sees the pointer over everything inside, and loses it when the
        // pointer leaves the window.
        hover := TouchArea {
            // Drag the picture to move the window. On Windows the app moves it
            // (mini.rs): the system's move loop would snap it to screen edges.
            if Playback.mini-native-drag: Picture {
                native-drag: true;
                focus-keys => { keys.focus(); }
            }
            if !Playback.mini-native-drag: WindowMoveArea {
                width: 100%;
                height: 100%;
                Picture {
                    focus-keys => { keys.focus(); }
                }
            }

            Rectangle {
                opacity: root.shown ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: 150ms; }
                background: @linear-gradient(180deg, #000000b3 0%, #00000040 35%, #00000040 60%, #000000cc 100%);

                // As Edge's picture-in-picture: back to the full player on the
                // left, close (leave the player) on the right.
                IconButton {
                    x: 4px;
                    y: 2px;
                    icon: @image-url("icons/m-open-in-full.svg");
                    icon-size: 18px;
                    clicked => { Playback.toggle-mini(); }
                }
                Text {
                    x: 44px;
                    y: 11px;
                    width: parent.width - 88px;
                    text: Playback.title;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }
                IconButton {
                    x: parent.width - self.width - 4px;
                    y: 2px;
                    icon: @image-url("icons/m-close.svg");
                    icon-size: 20px;
                    clicked => { Playback.back(); }
                }

                HorizontalLayout {
                    y: (parent.height - self.height) / 2;
                    height: 48px;
                    alignment: center;
                    spacing: 6px;
                    IconButton {
                        y: 5px;
                        icon: @image-url("icons/m-replay-10.svg");
                        clicked => { Playback.seek-by(-10); }
                    }
                    IconButton {
                        width: 48px;
                        height: 48px;
                        icon: Playback.paused ? @image-url("icons/m-play-arrow.svg") : @image-url("icons/m-pause.svg");
                        icon-size: 30px;
                        clicked => { Playback.toggle-pause(); }
                    }
                    IconButton {
                        y: 5px;
                        icon: @image-url("icons/m-forward-10.svg");
                        clicked => { Playback.seek-by(10); }
                    }
                    IconButton {
                        y: 5px;
                        icon: @image-url("icons/m-skip-next.svg");
                        enabled: Playback.has-next;
                        clicked => { Playback.next(); }
                    }
                }

                seek := Scrubber {
                    x: 10px;
                    y: parent.height - self.height - 4px;
                    width: parent.width - 20px;
                    value: root.progress;
                    committed(v) => { Playback.seek(v * Playback.duration); }
                }
            }

            // At rest, a hairline of progress along the bottom edge.
            if !root.shown: Rectangle {
                x: 0;
                y: parent.height - self.height;
                width: parent.width * root.progress;
                height: 3px;
                background: #ffffffb3;
            }

            // Autoplay stopped for this lecture's resources: they're in the
            // full player.
            if Playback.open-menu == "exercise": Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 34px;
                width: chip.preferred-width;
                height: 30px;
                border-radius: 15px;
                background: #ffffffeb;
                chip := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: "Resources waiting · open player";
                        color: #111111;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Playback.toggle-mini(); }
                }
            }
        }
    }
}
