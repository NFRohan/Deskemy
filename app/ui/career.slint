// Career tracks — ordered learning paths of courses — as the Tauri app's
// routes/tracks and routes/tracks/[id].

import { Theme } from "theme.slint";
import { Course, DialogButton, Field, IconAction, MenuItem } from "course.slint";
import { Library } from "library.slint";

export struct TrackCard {
    id: string,
    name: string,
    description: string,
    /// "3 courses · 12 / 40 lectures".
    meta: string,
    percent: int,
    /// Its header image, if one was picked.
    header: image,
    has-header: bool,
}

export struct TrackCourseRow {
    id: string,
    title: string,
    thumbnail: image,
    has-thumbnail: bool,
    done: int,
    total: int,
    percent: int,
    /// "done", "started" or "".
    status: string,
    /// The first unfinished course — the one to work on next.
    next: bool,
    /// Its place in the track, from 1.
    number: int,
    /// "245 lectures · 21h 30m".
    meta: string,
}

/// A library course offered by "Add courses".
export struct PickRow {
    id: string,
    title: string,
    /// "12 lectures".
    lectures: string,
    thumbnail: image,
    has-thumbnail: bool,
}

export global Tracks {
    in property <[TrackCard]> tracks;
    /// Some track has a header image: the cards all make room for one.
    in property <bool> any-header;

    // The open track.
    in property <bool> found: true;
    in property <string> id;
    in property <string> name;
    in property <string> description;
    /// Its header image, if one was picked.
    in property <image> header;
    in property <bool> has-header;
    in-out property <string> header-error;
    in property <int> percent;
    /// "40% · 12 / 30 lectures".
    in property <string> summary;
    /// "3 COURSES".
    in property <string> count-label;
    in property <[TrackCourseRow]> courses;
    /// "3 courses · 705 lectures · 27h 11m".
    in property <string> meta;
    /// "Not started", "In progress" or "Completed".
    in property <string> state;
    in property <int> lectures-done;
    in property <int> lectures-total;
    in property <int> courses-done;
    /// "18h 40m", or "—" when unknown or none.
    in property <string> time-left;
    /// The course to work on next (an index into courses), or -1.
    in property <int> next-index: -1;
    /// The lecture it resumes at (id, title), "Continue" or "Start course",
    /// and "~3h 10m left" in it.
    in property <string> next-lecture;
    in property <string> next-lecture-title;
    in property <string> next-label;
    in property <string> next-left;

    // "Add courses".
    in property <[PickRow]> pickable;
    in property <string> pick-empty;
    in-out property <string> pick-query;

    /// The open dialog: "" (none), "create", "edit", "delete" or "add".
    in-out property <string> dialog;
    in-out property <string> draft-name;
    in-out property <string> draft-description;
    in-out property <string> error;

    callback open(string);
    callback create(string, string);
    callback save(string, string);
    callback delete-track();
    /// Pick a header image for the open track, or remove it.
    callback pick-header();
    callback clear-header();
    callback filter(string);
    callback add-course(string);
    callback remove-course(string);
    /// Move the course at an index up (-1) or down (1).
    callback move(int, int);
}

component PageHeading inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    spacing: 8px;
    alignment: start;
    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        y: (parent.height - self.height) / 2;
        colorize: Theme.on-surface;
    }
    Text {
        text: root.text;
        color: Theme.on-surface;
        font-size: Theme.headline-sm;
        font-weight: 600;
        vertical-alignment: center;
    }
}

component Bar inherits Rectangle {
    in property <int> value;
    border-radius: self.height / 2;
    background: Theme.surface-container-highest;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(100, root.value)) / 100;
        border-radius: parent.border-radius;
        background: Theme.primary;
    }
}

component Thumb inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    border-radius: 4px;
    background: Theme.surface-container-highest;
    clip: true;
    if root.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    if !root.has-image: Image {
        source: @image-url("icons/video.svg");
        width: 18px;
        height: 18px;
        colorize: Theme.outline-variant;
    }
}

component TrackCardView inherits Rectangle {
    in property <TrackCard> track;
    /// Room for a header image across the top (a plain strip without one).
    in property <bool> banner;
    callback clicked;

    border-radius: 12px;
    clip: true;
    background: touch.has-hover ? Theme.surface-container : Theme.surface-container-low;
    accessible-role: button;
    accessible-label: root.track.name;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        if root.banner: Rectangle {
            height: 110px;
            background: Theme.surface-container-high;
            if root.track.has-header: Image {
                width: parent.width;
                height: parent.height;
                source: root.track.header;
                image-fit: cover;
            }
            if !root.track.has-header: Image {
                source: @image-url("icons/route.svg");
                width: 28px;
                height: 28px;
                colorize: Theme.outline-variant;
            }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.track.name;
                    color: Theme.on-surface;
                    font-size: Theme.headline-sm;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.track.percent + "%";
                    color: Theme.on-surface-variant;
                    font-size: Theme.label-md;
                }
            }
            // Two lines at most; the card keeps one height for the grid.
            Text {
                text: root.track.description;
                color: Theme.on-surface-variant;
                font-size: Theme.body-sm;
                wrap: word-wrap;
                overflow: elide;
                height: 36px;
                vertical-alignment: top;
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: root.track.meta;
                color: Theme.on-surface-variant;
                font-size: Theme.label-sm;
            }
            Bar {
                height: 6px;
                value: root.track.percent;
            }
        }
    }

    // The border over the image, not under it.
    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.outline-variant;
    }
}

component NewTrackButton inherits DialogButton {
    kind: "primary";
    text: "New track";
    icon: @image-url("icons/plus.svg");
    has-icon: true;
    clicked => {
        Tracks.draft-name = "";
        Tracks.draft-description = "";
        Tracks.error = "";
        Tracks.dialog = "create";
    }
}

export component TracksPage inherits Flickable {
    content-width: self.width;
    content-height: page.preferred-height;
    property <length> page-width: min(self.width - 48px, 1024px);
    property <int> columns: root.page-width >= 640px ? 2 : 1;
    property <length> gap: 12px;
    property <length> card-width: (root.page-width - (root.columns - 1) * root.gap) / root.columns;
    property <length> card-height: Tracks.any-header ? 246px : 136px;

    page := VerticalLayout {
        width: root.width;
        padding: 24px;
        padding-left: (root.width - root.page-width) / 2;
        padding-right: self.padding-left;
        spacing: 24px;
        alignment: start;

        HorizontalLayout {
            PageHeading {
                icon: @image-url("icons/route.svg");
                text: "Career Tracks";
                horizontal-stretch: 1;
            }
            NewTrackButton { }
        }

        if Tracks.tracks.length == 0: VerticalLayout {
            padding-top: 48px;
            spacing: 16px;
            Text {
                text: "No tracks yet. Group courses into an ordered learning path — like \"Platform Engineering\": Linux → Docker → Kubernetes.";
                color: Theme.on-surface-variant;
                font-size: Theme.body-md;
                horizontal-alignment: center;
                wrap: word-wrap;
                max-width: root.page-width;
            }
            HorizontalLayout {
                alignment: center;
                NewTrackButton { }
            }
        }

        if Tracks.tracks.length > 0: Rectangle {
            height: ceil(Tracks.tracks.length / root.columns) * (root.card-height + root.gap) - root.gap;
            for track[i] in Tracks.tracks: TrackCardView {
                x: mod(i, root.columns) * (root.card-width + root.gap);
                y: floor(i / root.columns) * (root.card-height + root.gap);
                width: root.card-width;
                height: root.card-height;
                banner: Tracks.any-header;
                track: track;
                clicked => { Tracks.open(track.id); }
            }
        }
    }
}

/// A small rounded label naming a state: "Up next", "In progress"…
component StatePill inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    /// Filled with the tint (for "Up next"), not tinted.
    in property <bool> solid;
    height: 20px;
    width: pill-text.preferred-width + 16px;
    border-radius: 10px;
    background: root.solid ? root.tint : root.tint.transparentize(0.85);
    pill-text := Text {
        text: root.text;
        color: root.solid ? Theme.on-primary-container : root.tint;
        font-size: Theme.label-sm;
        font-weight: 600;
    }
}

/// A small capitalised heading: "NEXT UP".
component Eyebrow inherits Text {
    color: Theme.on-surface-variant;
    font-size: Theme.label-sm;
    font-weight: 600;
    letter-spacing: 0.6px;
}

/// ⋮ on a milestone: move it, or take it out of the track.
component MilestoneMenu inherits Rectangle {
    in property <string> course-id;
    in property <int> index;
    in property <bool> last;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-container-highest : transparent;
    accessible-role: button;
    accessible-label: "More";
    accessible-action-default => { popup.show(); }
    Image {
        source: @image-url("icons/ellipsis-vertical.svg");
        width: 18px;
        height: 18px;
        colorize: Theme.on-surface-variant;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 200px;
        Rectangle {
            background: Theme.surface-container;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.outline-variant;
            VerticalLayout {
                padding: 4px;
                if root.index > 0: MenuItem {
                    icon: @image-url("icons/chevron-up.svg");
                    text: "Move earlier";
                    clicked => { Tracks.move(root.index, -1); }
                }
                if !root.last: MenuItem {
                    icon: @image-url("icons/chevron-down.svg");
                    text: "Move later";
                    clicked => { Tracks.move(root.index, 1); }
                }
                MenuItem {
                    icon: @image-url("icons/x.svg");
                    text: "Remove from track";
                    danger: true;
                    clicked => { Tracks.remove-course(root.course-id); }
                }
            }
        }
    }
}

/// A course on the roadmap: its step on the line down the left (a tick once
/// done, its number until then), and its card.
component Milestone inherits HorizontalLayout {
    in property <TrackCourseRow> course;
    in property <int> index;
    in property <bool> last;
    /// The space down to the next milestone, which the line spans.
    in property <length> gap: 12px;
    property <bool> done: root.course.status == "done";

    height: 112px;
    spacing: 16px;

    // The rail: the line on to the next step, then this step over it.
    Rectangle {
        width: 32px;
        if !root.last: Rectangle {
            x: 15px;
            y: parent.height / 2;
            width: 2px;
            height: parent.height + root.gap;
            background: root.done ? Theme.secondary-container : Theme.outline-variant;
        }
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: root.done ? Theme.secondary-container : Theme.background;
            border-width: root.done ? 0 : 2px;
            border-color: root.course.next ? Theme.primary-container : Theme.outline-variant;
            if root.done: Image {
                source: @image-url("icons/check.svg");
                width: 16px;
                height: 16px;
                colorize: #ffffff;
            }
            if !root.done: Text {
                text: root.course.number;
                color: root.course.next ? Theme.primary : Theme.on-surface-variant;
                font-size: Theme.label-md;
                font-weight: 700;
            }
        }
    }

    Rectangle {
        horizontal-stretch: 1;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.course.next ? Theme.primary-container.transparentize(0.4) : Theme.outline-variant;
        background: root.course.next ? Theme.primary-container.transparentize(0.92)
            : touch.has-hover ? Theme.surface-container : Theme.surface-container-low;
        accessible-role: button;
        accessible-label: root.course.title;
        accessible-action-default => { Library.show-course(root.course.id); }
        // The card opens the course's page.
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Library.show-course(root.course.id); }
        }
        HorizontalLayout {
            padding: 14px;
            padding-right: 8px;
            spacing: 16px;
            Thumb {
                width: 150px;
                height: 84px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                source: root.course.thumbnail;
                has-image: root.course.has-thumbnail;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    StatePill {
                        text: root.course.next ? "Up next" : root.done ? "Completed"
                            : root.course.status == "started" ? "In progress" : "Not started";
                        tint: root.course.next ? Theme.primary-container : root.done ? Theme.secondary-container
                            : root.course.status == "started" ? Theme.primary : Theme.on-surface-variant;
                        solid: root.course.next;
                    }
                }
                Text {
                    text: root.course.title;
                    color: touch.has-hover ? Theme.primary : Theme.on-surface;
                    font-size: Theme.headline-sm;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.course.meta;
                    color: Theme.on-surface-variant;
                    font-size: Theme.label-md;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Bar {
                        horizontal-stretch: 1;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        value: root.course.percent;
                    }
                    Text {
                        text: root.course.done + " / " + root.course.total;
                        color: Theme.on-surface-variant;
                        font-size: Theme.label-md;
                        vertical-alignment: center;
                    }
                }
            }
            MilestoneMenu {
                y: (parent.height - self.height) / 2;
                course-id: root.course.id;
                index: root.index;
                last: root.last;
            }
        }
    }
}

/// The courses in order, as steps down a line.
component Roadmap inherits VerticalLayout {
    spacing: 16px;
    alignment: start;
    HorizontalLayout {
        Text {
            text: "Learning roadmap";
            color: Theme.on-surface;
            font-size: Theme.headline-sm;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        DialogButton {
            text: "Add courses";
            icon: @image-url("icons/plus.svg");
            has-icon: true;
            clicked => {
                Tracks.pick-query = "";
                Tracks.filter("");
                Tracks.dialog = "add";
            }
        }
    }
    if Tracks.courses.length == 0: Rectangle {
        height: 140px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.outline-variant;
        Text {
            text: "No courses yet. Add the courses you mean to take, in the order you'll take them: each one is a step on the way.";
            color: Theme.on-surface-variant;
            font-size: Theme.body-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: min(parent.width - 48px, 420px);
        }
    }
    VerticalLayout {
        spacing: 12px;
        for course[i] in Tracks.courses: Milestone {
            course: course;
            index: i;
            last: i == Tracks.courses.length - 1;
        }
    }
}

/// The way into the next course: Continue / Start course.
component UpNextButton inherits Rectangle {
    in property <TrackCourseRow> course;
    height: 44px;
    border-radius: 8px;
    background: go-touch.has-hover ? Theme.inverse-primary : Theme.primary-container;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.primary-container.transparentize(0.65);
    accessible-role: button;
    accessible-label: Tracks.next-label;
    accessible-action-default => { self.go(); }
    function go() {
        if Tracks.next-lecture != "" {
            Course.play(Tracks.next-lecture);
        } else {
            Library.show-course(root.course.id);
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Image {
            source: @image-url("icons/play-filled.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.on-primary-container;
        }
        Text {
            text: Tracks.next-label;
            color: Theme.on-primary-container;
            font-size: Theme.body-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    go-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.go(); }
    }
}

/// The next course's title (to its page) and the lecture it resumes at.
component UpNextDetails inherits VerticalLayout {
    in property <TrackCourseRow> course;
    spacing: 6px;
    Text {
        text: root.course.title;
        color: title-touch.has-hover ? Theme.primary : Theme.on-surface;
        font-size: Theme.headline-sm;
        font-weight: 600;
        wrap: word-wrap;
        title-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Library.show-course(root.course.id); }
        }
    }
    if Tracks.next-lecture-title != "": Text {
        text: (Tracks.next-label == "Continue" ? "Resume at “" : "Begins with “") + Tracks.next-lecture-title + "”";
        color: Theme.on-surface-variant;
        font-size: Theme.body-sm;
        wrap: word-wrap;
    }
}

/// The course to work on next, and a button straight into it.
component UpNextCard inherits Rectangle {
    /// Side by side (a narrow window, the card full width), not stacked.
    in property <bool> compact;
    property <TrackCourseRow> course: Tracks.courses[Tracks.next-index];

    height: body.preferred-height;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.primary-container.transparentize(0.5);
    background: Theme.surface-container-low;

    body := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Eyebrow { text: "NEXT UP · COURSE " + root.course.number + " OF " + Tracks.courses.length; }
        if !root.compact: Thumb {
            height: 150px;
            border-radius: 8px;
            source: root.course.thumbnail;
            has-image: root.course.has-thumbnail;
        }
        if !root.compact: UpNextDetails { course: root.course; }
        if root.compact: HorizontalLayout {
            spacing: 16px;
            Thumb {
                width: 160px;
                height: 90px;
                border-radius: 8px;
                source: root.course.thumbnail;
                has-image: root.course.has-thumbnail;
            }
            UpNextDetails {
                horizontal-stretch: 1;
                course: root.course;
            }
        }
        UpNextButton { course: root.course; }
        if Tracks.next-left != "": Text {
            text: Tracks.next-left + " in this course";
            color: Theme.on-surface-variant;
            font-size: Theme.label-md;
            horizontal-alignment: center;
        }
    }
}

/// In place of "Next up" once every course is done.
component CompleteCard inherits Rectangle {
    height: body.preferred-height;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.secondary-container.transparentize(0.5);
    background: Theme.secondary-container.transparentize(0.92);
    body := VerticalLayout {
        padding: 20px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/trophy.svg");
                width: 36px;
                height: 36px;
                colorize: Theme.secondary-container;
            }
        }
        Text {
            text: "Track complete";
            color: Theme.on-surface;
            font-size: Theme.headline-sm;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "Every course on this roadmap is done. Add another to keep going.";
            color: Theme.on-surface-variant;
            font-size: Theme.body-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

/// One figure of the progress card: "643" over "Lectures left".
component Stat inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    horizontal-stretch: 1;
    spacing: 2px;
    Text {
        text: root.value;
        color: Theme.on-surface;
        font-size: Theme.headline-md;
        font-weight: 700;
    }
    Text {
        text: root.label;
        color: Theme.on-surface-variant;
        font-size: Theme.label-sm;
    }
}

/// How far along the track is: a percentage, a bar, and three figures.
component ProgressCard inherits Rectangle {
    height: body.preferred-height;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.outline-variant;
    background: Theme.surface-container-low;
    body := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            Text {
                text: "Your progress";
                color: Theme.on-surface;
                font-size: Theme.body-md;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            StatePill {
                text: Tracks.state;
                tint: Tracks.state == "Completed" ? Theme.secondary-container
                    : Tracks.state == "In progress" ? Theme.primary : Theme.on-surface-variant;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: Tracks.percent + "%";
                color: Tracks.percent >= 100 ? Theme.secondary-container : Theme.primary;
                font-size: 30px;
                font-weight: 700;
            }
            Text {
                text: Tracks.lectures-done + " of " + Tracks.lectures-total + " lectures";
                color: Theme.on-surface-variant;
                font-size: Theme.label-md;
                vertical-alignment: bottom;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
        }
        Bar {
            height: 8px;
            value: Tracks.percent;
        }
        HorizontalLayout {
            spacing: 8px;
            padding-top: 4px;
            Stat {
                value: Tracks.courses-done + "/" + Tracks.courses.length;
                label: "Courses done";
            }
            Stat {
                value: Tracks.lectures-total - Tracks.lectures-done;
                label: "Lectures left";
            }
            Stat {
                value: Tracks.time-left;
                label: "Time left";
            }
        }
    }
}

/// ⋮ on the track: its header image, and deleting it.
component TrackMenu inherits Rectangle {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-container-highest : transparent;
    accessible-role: button;
    accessible-label: "More";
    accessible-action-default => { popup.show(); }
    Image {
        source: @image-url("icons/ellipsis-vertical.svg");
        width: 20px;
        height: 20px;
        colorize: Theme.on-surface-variant;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 210px;
        Rectangle {
            background: Theme.surface-container;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.outline-variant;
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    icon: @image-url("icons/image-plus.svg");
                    text: Tracks.has-header ? "Change header image…" : "Add a header image…";
                    clicked => { Tracks.pick-header(); }
                }
                if Tracks.has-header: MenuItem {
                    icon: @image-url("icons/x.svg");
                    text: "Remove header image";
                    clicked => { Tracks.clear-header(); }
                }
                MenuItem {
                    icon: @image-url("icons/trash-2.svg");
                    text: "Delete track";
                    danger: true;
                    clicked => { Tracks.dialog = "delete"; }
                }
            }
        }
    }
}

export component TrackPage inherits Flickable {
    content-width: self.width;
    content-height: page.preferred-height;
    property <length> page-width: min(self.width - 48px, 1120px);
    /// Room for the roadmap and a side column beside it.
    property <bool> wide: root.page-width >= 860px;

    page := VerticalLayout {
        width: root.width;
        padding: 24px;
        padding-left: (root.width - root.page-width) / 2;
        padding-right: self.padding-left;
        spacing: 24px;
        alignment: start;

        if !Tracks.found: Text {
            text: "Track not found.";
            color: Theme.error;
            font-size: Theme.body-sm;
            horizontal-alignment: center;
            height: 128px;
            vertical-alignment: center;
        }

        // The track: its banner (its header image, or artwork of its own),
        // name, what's in it, and what it's for.
        if Tracks.found: Rectangle {
            height: identity.preferred-height;
            border-radius: 12px;
            clip: true;
            background: Theme.surface-container-low;

            identity := VerticalLayout {
                Rectangle {
                    height: 140px;
                    if Tracks.has-header: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Tracks.header;
                        image-fit: cover;
                    }
                    if !Tracks.has-header: Rectangle {
                        background: @linear-gradient(110deg, #2a1650 0%, Theme.primary-container 62%, Theme.accent-blue 100%);
                        Image {
                            x: parent.width - self.width - 40px;
                            source: @image-url("icons/route.svg");
                            width: 104px;
                            height: 104px;
                            colorize: #ffffff;
                            opacity: 0.22;
                        }
                    }
                }
                VerticalLayout {
                    padding: 20px;
                    padding-top: 16px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: Tracks.name;
                            color: Theme.on-surface;
                            font-size: Theme.display-sm;
                            font-weight: 700;
                            wrap: word-wrap;
                            // A long unbroken name breaks anywhere instead of
                            // widening the card.
                            min-width: 0px;
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 2px;
                            IconAction {
                                label: "Edit track";
                                icon: @image-url("icons/pencil.svg");
                                tint: self.hovered ? Theme.on-surface : Theme.on-surface-variant;
                                clicked => {
                                    Tracks.draft-name = Tracks.name;
                                    Tracks.draft-description = Tracks.description;
                                    Tracks.error = "";
                                    Tracks.dialog = "edit";
                                }
                            }
                            TrackMenu { }
                        }
                    }
                    Text {
                        text: Tracks.meta;
                        color: Theme.on-surface-variant;
                        font-size: Theme.label-md;
                    }
                    if Tracks.description != "": Text {
                        text: Tracks.description;
                        color: Theme.on-surface;
                        font-size: Theme.body-md;
                        wrap: word-wrap;
                    }
                    if Tracks.description == "": Text {
                        text: "+ Add what this track is for";
                        color: add-touch.has-hover ? Theme.primary : Theme.on-surface-variant;
                        font-size: Theme.body-sm;
                        add-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Tracks.draft-name = Tracks.name;
                                Tracks.draft-description = Tracks.description;
                                Tracks.error = "";
                                Tracks.dialog = "edit";
                            }
                        }
                    }
                    if Tracks.header-error != "": Text {
                        text: Tracks.header-error;
                        color: Theme.error;
                        font-size: Theme.body-sm;
                        wrap: word-wrap;
                    }
                }
            }
            // The border over the banner, not under it.
            Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.outline-variant;
            }
        }

        // Wide: the roadmap, and beside it what's next and how far along.
        if Tracks.found && root.wide: HorizontalLayout {
            spacing: 24px;
            Roadmap {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                width: 300px;
                alignment: start;
                spacing: 16px;
                if Tracks.next-index >= 0: UpNextCard { }
                if Tracks.next-index < 0 && Tracks.courses.length > 0: CompleteCard { }
                ProgressCard { }
            }
        }

        // Narrow: the same, one under another.
        if Tracks.found && !root.wide: VerticalLayout {
            spacing: 16px;
            if Tracks.next-index >= 0: UpNextCard {
                compact: true;
            }
            if Tracks.next-index < 0 && Tracks.courses.length > 0: CompleteCard { }
            ProgressCard { }
            Roadmap { }
        }
    }
}

/// A bordered text box; `multiline` makes it a two-line description area.
component FieldLabel inherits Text {
    color: Theme.on-surface-variant;
    font-size: Theme.label-md;
}

component CloseButton inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-container-highest : transparent;
    accessible-role: button;
    accessible-label: "Close";
    accessible-action-default => { Tracks.dialog = ""; }
    Image {
        source: @image-url("icons/x.svg");
        width: 18px;
        height: 18px;
        colorize: Theme.on-surface-variant;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tracks.dialog = ""; }
    }
}

component DialogTitle inherits Text {
    color: Theme.on-surface;
    font-size: Theme.headline-sm;
    font-weight: 600;
    vertical-alignment: center;
}

component PickRowView inherits Rectangle {
    in property <PickRow> course;
    height: 52px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.surface-container-high : transparent;
    accessible-role: button;
    accessible-label: "Add " + root.course.title;
    accessible-action-default => { Tracks.add-course(root.course.id); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tracks.add-course(root.course.id); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        Thumb {
            width: 56px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            source: root.course.thumbnail;
            has-image: root.course.has-thumbnail;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.course.title;
                color: Theme.on-surface;
                font-size: Theme.body-md;
                overflow: elide;
            }
            Text {
                text: root.course.lectures;
                color: Theme.on-surface-variant;
                font-size: Theme.label-sm;
            }
        }
        Image {
            source: @image-url("icons/plus.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.on-surface-variant;
        }
    }
}

/// The tracks pages' dialogs, over the whole (dimmed) window. Esc closes.
export component TrackDialogs inherits Rectangle {
    background: #00000099;

    // See CourseDialogs: capping wrapped text at the room actually available
    // makes the measured height the wrapped one.
    property <length> card-width: min(448px, root.width - 32px);
    property <length> text-width: root.card-width - 40px;

    keys := FocusScope {
        // Dialogs with a text box focus it instead; Esc still bubbles here.
        init => {
            if Tracks.dialog == "delete" {
                self.focus();
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                Tracks.dialog = "";
                return accept;
            }
            return reject;
        }

        TouchArea {
            clicked => { Tracks.dialog = ""; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.card-width;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    background: Theme.surface-container;

                    TouchArea { }

                    VerticalLayout {
                        padding: 20px;

                        if Tracks.dialog == "create" || Tracks.dialog == "edit": VerticalLayout {
                            spacing: 16px;
                            HorizontalLayout {
                                DialogTitle {
                                    text: Tracks.dialog == "create" ? "New career track" : "Edit track";
                                    horizontal-stretch: 1;
                                }
                                if Tracks.dialog == "create": CloseButton { }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { text: "Name"; }
                                Field {
                                    text <=> Tracks.draft-name;
                                    placeholder: Tracks.dialog == "create" ? "e.g. Platform Engineering" : "";
                                    autofocus: true;
                                    accepted => {
                                        if Tracks.dialog == "create" {
                                            Tracks.create(Tracks.draft-name, Tracks.draft-description);
                                        } else {
                                            Tracks.save(Tracks.draft-name, Tracks.draft-description);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { text: "Description (optional)"; }
                                Field {
                                    text <=> Tracks.draft-description;
                                    multiline: true;
                                }
                            }
                            if Tracks.error != "": Text {
                                text: Tracks.error;
                                color: Theme.error;
                                font-size: Theme.label-sm;
                                wrap: word-wrap;
                                max-width: root.text-width;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                DialogButton {
                                    text: "Cancel";
                                    clicked => { Tracks.dialog = ""; }
                                }
                                DialogButton {
                                    kind: "primary";
                                    text: Tracks.dialog == "create" ? "Create" : "Save";
                                    active: Tracks.draft-name != "";
                                    clicked => {
                                        if Tracks.dialog == "create" {
                                            Tracks.create(Tracks.draft-name, Tracks.draft-description);
                                        } else {
                                            Tracks.save(Tracks.draft-name, Tracks.draft-description);
                                        }
                                    }
                                }
                            }
                        }

                        if Tracks.dialog == "delete": VerticalLayout {
                            spacing: 16px;
                            DialogTitle {
                                text: "Delete \"" + Tracks.name + "\"?";
                                wrap: word-wrap;
                                // A long unbroken name (underscores, no spaces) breaks anywhere
                                // instead of widening the layout past its card.
                                min-width: 0px;
                                max-width: root.text-width;
                            }
                            Text {
                                text: "This removes the track and its ordering only. Your courses, progress and bookmarks are untouched.";
                                color: Theme.on-surface-variant;
                                font-size: Theme.body-sm;
                                wrap: word-wrap;
                                max-width: root.text-width;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                DialogButton {
                                    text: "Cancel";
                                    clicked => { Tracks.dialog = ""; }
                                }
                                DialogButton {
                                    kind: "danger";
                                    text: "Delete track";
                                    icon: @image-url("icons/trash-2.svg");
                                    has-icon: true;
                                    clicked => { Tracks.delete-track(); }
                                }
                            }
                        }

                        if Tracks.dialog == "add": VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                DialogTitle {
                                    text: "Add courses";
                                    horizontal-stretch: 1;
                                }
                                CloseButton { }
                            }
                            Field {
                                text <=> Tracks.pick-query;
                                placeholder: "Filter courses…";
                                autofocus: true;
                                edited(query) => { Tracks.filter(query); }
                            }
                            if Tracks.pickable.length == 0: Text {
                                text: Tracks.pick-empty;
                                color: Theme.on-surface-variant;
                                font-size: Theme.body-sm;
                                horizontal-alignment: center;
                                height: 80px;
                                vertical-alignment: center;
                            }
                            // Up to 80% of the window, then it scrolls.
                            if Tracks.pickable.length > 0: Flickable {
                                height: min(picks.preferred-height, root.height * 0.8 - 150px);
                                content-width: self.width;
                                content-height: picks.preferred-height;
                                picks := VerticalLayout {
                                    width: parent.width;
                                    spacing: 4px;
                                    for course in Tracks.pickable: PickRowView {
                                        course: course;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
