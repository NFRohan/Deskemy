// Settings, as the Tauri app's routes/settings.

import { Theme } from "theme.slint";
import { Select, SelectOption } from "library.slint";
import { AboutSlint, Palette } from "std-widgets.slint";
import { Updates } from "updates.slint";

/// Preferences from config.json (every change goes through `set(key, value)`
/// and comes back once saved), and the maintenance actions (`run(key)`).
export global Prefs {
    in property <[SelectOption]> themes;
    in property <[SelectOption]> speeds;
    in property <[SelectOption]> goals;
    in-out property <string> theme;
    in property <string> theme-label;
    in-out property <string> speed;
    in property <string> speed-label;
    in-out property <string> goal;
    in property <string> goal-label;
    in property <bool> autoplay;
    in property <bool> autohide;
    in property <bool> clean-titles;
    in property <bool> auto-rescan;
    in property <bool> resources-inline;
    in property <bool> pause-at-resources;
    in property <bool> mini-return-here;

    callback set(string, string);

    /// The maintenance action running ("" = none); they run one at a time.
    in property <string> busy;
    in-out property <string> result-reconcile;
    in-out property <string> result-reindex;
    in-out property <string> result-subs;
    in-out property <string> result-compact;
    in-out property <string> result-clearsubs;
    in-out property <string> result-gc;
    callback run(string);
    public function set-result(key: string, message: string) {
        if key == "reconcile" { self.result-reconcile = message; }
        if key == "reindex" { self.result-reindex = message; }
        if key == "subs" { self.result-subs = message; }
        if key == "compact" { self.result-compact = message; }
        if key == "clearsubs" { self.result-clearsubs = message; }
        if key == "gc" { self.result-gc = message; }
        if key == "export" { self.result-export = message; }
    }

    // Backups. An import error shows under its row.
    in property <string> result-import;
    in-out property <string> result-export;
    in-out property <bool> import-confirm;
    callback confirm-import();

    in property <string> version;

    // Storage ("—" without a data folder; cues -1).
    in property <string> db-size: "—";
    in property <string> thumbnail-size: "—";
    in property <int> cues: -1;
    in property <string> cues-label: "—";
}

/// A maintenance button: spins while its action runs, and waits while any other does.
/// Settings → About's update button: Check, Update to X, or progress.
component UpdateButton inherits Rectangle {
    property <bool> offer: Updates.status == "available";
    property <bool> busy: Updates.status == "checking" || Updates.status == "downloading" || Updates.status == "restarting";

    height: 36px;
    width: row.preferred-width;
    border-radius: 4px;
    background: root.offer ? (touch.has-hover ? Theme.inverse-primary : Theme.primary-container)
        : !root.busy && touch.has-hover ? Theme.surface-container-highest : Theme.surface-container-high;
    opacity: root.busy ? 0.8 : 1;
    accessible-role: button;
    accessible-label: label.text;

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Image {
            source: root.busy ? @image-url("icons/loader-circle.svg")
                : root.offer ? @image-url("icons/download.svg") : @image-url("icons/refresh-cw.svg");
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: label.color;
            transform-rotation: root.busy ? animation-tick() / 1s * 360deg : 0deg;
        }
        label := Text {
            text: Updates.status == "checking" ? "Checking…"
                : Updates.status == "downloading" ? "Downloading " + Updates.progress + "%"
                : Updates.status == "restarting" ? "Restarting…"
                : root.offer ? "Update to " + Updates.version : "Check";
            color: root.offer ? Theme.on-primary-container : Theme.on-surface;
            font-size: Theme.label-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => {
            if root.offer {
                Updates.install();
            } else {
                Updates.check();
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> key;
    in property <string> text;
    in property <image> icon;
    in property <bool> active: true;
    property <bool> running: Prefs.busy == root.key;
    property <bool> usable: root.active && Prefs.busy == "";

    height: 36px;
    width: row.preferred-width;
    border-radius: 4px;
    background: root.usable && touch.has-hover ? Theme.surface-container-highest : Theme.surface-container-high;
    opacity: root.usable || root.running ? 1 : 0.6;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.usable;
    accessible-action-default => { Prefs.run(root.key); }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Image {
            source: root.running ? @image-url("icons/loader-circle.svg") : root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.on-surface;
            transform-rotation: root.running ? animation-tick() / 1s * 360deg : 0deg;
        }
        Text {
            text: root.text;
            color: Theme.on-surface;
            font-size: Theme.label-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.usable;
        mouse-cursor: pointer;
        clicked => { Prefs.run(root.key); }
    }
}

component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled;

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.primary-container : Theme.surface-container-highest;
    animate background { duration: 150ms; }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        x: root.checked ? 22px : 2px;
        animate x { duration: 150ms; }
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        // Keeps the knob visible on the light theme's pale track.
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

/// A setting: its name and what it does, with the control on the right.
component Row inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    /// Room for the text (the page sets it from its width).
    in property <length> text-width;
    /// The last result of the row's action.
    in property <string> result;
    in property <bool> result-error;

    padding: 16px;
    spacing: 16px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.on-surface;
            font-size: Theme.body-md;
        }
        // max-width: wrapped text is measured at its one-line width.
        Text {
            text: root.description;
            color: Theme.on-surface-variant;
            font-size: Theme.label-sm;
            wrap: word-wrap;
            max-width: root.text-width;
        }        if root.result != "": Text {
            text: root.result;
            color: root.result-error ? Theme.error : Theme.primary;
            font-size: Theme.label-sm;
            wrap: word-wrap;
            max-width: root.text-width;
        }
    }
    // The text's max-width leaves spare room here: keep the control flush right.
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: end;
            @children
        }
    }
}

component Group inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.outline-variant;
    background: Theme.surface-container-low;
    clip: true;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.outline-variant;
}

component Heading inherits Text {
    color: Theme.on-surface-variant;
    font-size: Theme.label-md;
    font-weight: 600;
    letter-spacing: 0.5px;
}

export component SettingsPage inherits Flickable {
    content-width: self.width;
    content-height: page.preferred-height;
    property <length> page-width: min(self.width - 48px, 672px);
    // Row text beside a control up to ~140px wide.
    property <length> text-width: root.page-width - 32px - 16px - 140px;

    page := VerticalLayout {
        width: root.width;
        padding: 24px;
        padding-left: (root.width - root.page-width) / 2;
        padding-right: self.padding-left;
        spacing: 32px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Image {
                source: @image-url("icons/settings.svg");
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                colorize: Theme.on-surface;
            }
            Text {
                text: "Settings";
                color: Theme.on-surface;
                font-size: Theme.headline-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "APPEARANCE"; }
            Group {
                height: appearance.preferred-height;
                appearance := VerticalLayout {
                    Row {
                        title: "Theme";
                        description: "Follow the system or force light/dark.";
                        text-width: root.text-width;
                        Select {
                            options: Prefs.themes;
                            value <=> Prefs.theme;
                            label: Prefs.theme-label;
                            changed => { Prefs.set("theme", self.value); }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "PLAYBACK"; }
            Group {
                height: playback.preferred-height;
                playback := VerticalLayout {
                    Row {
                        title: "Default playback speed";
                        description: "Applied when a lecture opens.";
                        text-width: root.text-width;
                        Select {
                            options: Prefs.speeds;
                            value <=> Prefs.speed;
                            label: Prefs.speed-label;
                            changed => { Prefs.set("speed", self.value); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Autoplay next lecture";
                        description: "Advance automatically when one ends.";
                        text-width: root.text-width;
                        Switch {
                            label: "Autoplay next lecture";
                            checked: Prefs.autoplay;
                            toggled => { Prefs.set("autoplay", Prefs.autoplay ? "false" : "true"); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Auto-hide controls in fullscreen";
                        description: "Hide the controls and cursor after a few seconds without mouse movement while fullscreen (VLC-style). Off keeps them visible in fullscreen; in a window they always tuck away, as they sit over the video.";
                        text-width: root.text-width;
                        Switch {
                            label: "Auto-hide controls in fullscreen";
                            checked: Prefs.autohide;
                            toggled => { Prefs.set("autohide", Prefs.autohide ? "false" : "true"); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Open the full player where the mini player is";
                        description: "Leaving the mini player on another monitor opens the full window there. Off brings it back where it was before.";
                        text-width: root.text-width;
                        Switch {
                            label: "Open the full player where the mini player is";
                            checked: Prefs.mini-return-here;
                            toggled => { Prefs.set("mini-return-here", Prefs.mini-return-here ? "false" : "true"); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Daily goal";
                        description: "Target watch time per day (Stats).";
                        text-width: root.text-width;
                        Select {
                            options: Prefs.goals;
                            value <=> Prefs.goal;
                            label: Prefs.goal-label;
                            changed => { Prefs.set("goal", self.value); }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "RESOURCES"; }
            Group {
                height: resources.preferred-height;
                resources := VerticalLayout {
                    Row {
                        title: "Keep videos and resources together";
                        description: "Show each lecture's exercises, notes and files right under it — in the course's curriculum and the player's course panel — instead of only in a separate list.";
                        text-width: root.text-width;
                        Switch {
                            label: "Keep videos and resources together";
                            checked: Prefs.resources-inline;
                            toggled => { Prefs.set("resources-inline", Prefs.resources-inline ? "false" : "true"); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Pause on exercises and resources";
                        description: "When a lecture that has resources ends, autoplay stops and offers to open them before moving on to the next lecture.";
                        text-width: root.text-width;
                        Switch {
                            label: "Pause on exercises and resources";
                            checked: Prefs.pause-at-resources;
                            toggled => { Prefs.set("pause-at-resources", Prefs.pause-at-resources ? "false" : "true"); }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "LIBRARY MAINTENANCE"; }
            Group {
                height: library.preferred-height;
                library := VerticalLayout {
                    Row {
                        title: "Clean up lecture titles";
                        description: "Strip leading numbers and file extensions on import (e.g. \"01. Intro.mp4\" → \"Intro\"). Off keeps the raw file and folder names. Applies to new imports.";
                        text-width: root.text-width;
                        Switch {
                            label: "Clean up lecture titles";
                            checked: Prefs.clean-titles;
                            toggled => { Prefs.set("clean-titles", Prefs.clean-titles ? "false" : "true"); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Auto-rescan folders";
                        description: "Re-import a course when its folder changes on disk. May briefly pause the UI while it re-scans; the course you're watching is never touched.";
                        text-width: root.text-width;
                        Switch {
                            label: "Auto-rescan folders";
                            checked: Prefs.auto-rescan;
                            toggled => { Prefs.set("auto-rescan", Prefs.auto-rescan ? "false" : "true"); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Check for missing files";
                        description: "Flag courses whose video files have moved or been deleted.";
                        text-width: root.text-width;
                        result: Prefs.result-reconcile;
                        ActionButton {
                            key: "reconcile";
                            text: "Check";
                            icon: @image-url("icons/file-search.svg");
                        }
                    }
                    Divider { }
                    Row {
                        title: "Rebuild search index";
                        description: "Refresh full-text search from the current library.";
                        text-width: root.text-width;
                        result: Prefs.result-reindex;
                        ActionButton {
                            key: "reindex";
                            text: "Rebuild";
                            icon: @image-url("icons/refresh-cw.svg");
                        }
                    }
                    Divider { }
                    Row {
                        title: "Index subtitle text";
                        description: "Parse sidecar subtitles so Search can find spoken words.";
                        text-width: root.text-width;
                        result: Prefs.result-subs;
                        ActionButton {
                            key: "subs";
                            text: "Index";
                            icon: @image-url("icons/captions.svg");
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "DATA"; }
            Group {
                height: data.preferred-height;
                data := VerticalLayout {
                    Row {
                        title: "Export backup";
                        description: "Save your library — progress, bookmarks, tags, tracks, thumbnails — to one .zip. Your video files aren't included. Handy for moving a portable copy to a new release, or as a safety backup.";
                        text-width: root.text-width;
                        result: Prefs.result-export;
                        ActionButton {
                            key: "export";
                            text: "Export";
                            icon: @image-url("icons/download.svg");
                        }
                    }
                    Divider { }
                    Row {
                        title: "Import backup";
                        description: "Replace this library with a backup, then restart. It re-links to your videos where they still exist — it can't restore progress onto a different download of a course.";
                        text-width: root.text-width;
                        result: Prefs.result-import;
                        result-error: true;
                        ActionButton {
                            key: "import";
                            text: "Import";
                            icon: @image-url("icons/upload.svg");
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "STORAGE"; }
            Group {
                height: storage.preferred-height;
                storage := VerticalLayout {
                    Row {
                        title: "Database";
                        description: "Course metadata, progress, bookmarks and search indexes — videos are never stored here. Compact reclaims space freed by removed courses or cleared indexes.";
                        text-width: root.text-width;
                        result: Prefs.result-compact;
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: Prefs.db-size;
                                color: Theme.on-surface;
                                font-size: Theme.label-md;
                                horizontal-alignment: right;
                            }
                            HorizontalLayout {
                                alignment: end;
                                ActionButton {
                                    key: "compact";
                                    text: "Compact";
                                    icon: @image-url("icons/minimize-2.svg");
                                }
                            }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Subtitle search index";
                        description: "Indexed subtitle text — the main database growth. Clearing frees the most space; re-index anytime with \"Index subtitle text\" above.";
                        text-width: root.text-width;
                        result: Prefs.result-clearsubs;
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: Prefs.cues-label;
                                color: Theme.on-surface;
                                font-size: Theme.label-md;
                                horizontal-alignment: right;
                            }
                            HorizontalLayout {
                                alignment: end;
                                ActionButton {
                                    key: "clearsubs";
                                    text: "Clear";
                                    icon: @image-url("icons/trash-2.svg");
                                    active: Prefs.cues != 0;
                                }
                            }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Thumbnail cache";
                        description: "Cached course covers and resume frames (stored on disk, not in the database). Clean deletes images no longer used by any course.";
                        text-width: root.text-width;
                        result: Prefs.result-gc;
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: Prefs.thumbnail-size;
                                color: Theme.on-surface;
                                font-size: Theme.label-md;
                                horizontal-alignment: right;
                            }
                            HorizontalLayout {
                                alignment: end;
                                ActionButton {
                                    key: "gc";
                                    text: "Clean";
                                    icon: @image-url("icons/trash-2.svg");
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            Heading { text: "ABOUT"; }
            Group {
                height: about.preferred-height;
                about := VerticalLayout {
                    Row {
                        title: "Deskemy " + Prefs.version;
                        description: "Check for a newer release. Nothing downloads until you confirm. Third-party licenses are in the licenses folder beside the app.";
                        text-width: root.text-width;
                        result: Updates.status == "latest" ? "You're on the latest version."
                            : Updates.status == "available" ? "Deskemy " + Updates.version + " is available."
                            : Updates.status == "error" ? Updates.error : "";
                        result-error: Updates.status == "error";
                        UpdateButton { }
                    }
                    Divider { }
                    // Slint's Royalty-free License asks for this attribution. The
                    // badge colours itself by Slint's palette (the OS theme), so
                    // it sits on that palette's background to stay readable.
                    HorizontalLayout {
                        padding: 16px;
                        alignment: center;
                        Rectangle {
                            border-radius: 8px;
                            background: Palette.background;
                            AboutSlint {
                                max-height: 96px;
                            }
                        }
                    }
                }
            }
        }
    }
}

component ConfirmButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 36px;
    width: label.preferred-width + 32px;
    border-radius: 4px;
    background: root.primary ? (touch.has-hover ? Theme.inverse-primary : Theme.primary-container)
        : touch.has-hover ? Theme.surface-container-highest : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-primary-container : Theme.on-surface;
        font-size: Theme.label-md;
        font-weight: 600;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// "Import backup?" over the whole (dimmed) window. Esc cancels.
export component ImportConfirm inherits Rectangle {
    background: #00000099;
    property <length> card-width: min(448px, root.width - 32px);

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                Prefs.import-confirm = false;
                return accept;
            }
            return reject;
        }
        TouchArea { }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.card-width;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    background: Theme.surface-container;
                    accessible-role: groupbox;
                    accessible-label: "Import backup?";
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text {
                            text: "Import backup?";
                            color: Theme.on-surface;
                            font-size: Theme.headline-sm;
                            font-weight: 600;
                        }
                        // max-width: see CourseDialogs.
                        Text {
                            text: "This replaces your current library — progress, bookmarks, tags, everything — with the backup, then restarts Deskemy. Your current data can't be recovered afterward unless you exported it first.";
                            color: Theme.on-surface-variant;
                            font-size: Theme.body-sm;
                            wrap: word-wrap;
                            max-width: root.card-width - 40px;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            ConfirmButton {
                                text: "Cancel";
                                clicked => { Prefs.import-confirm = false; }
                            }
                            ConfirmButton {
                                text: "Import & restart";
                                primary: true;
                                clicked => { Prefs.confirm-import(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
