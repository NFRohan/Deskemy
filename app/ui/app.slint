// Deskemy — Slint frontend (port in progress; see docs/slint-port.md).

export struct CourseRow {
    title: string,
    lectures: int,
    completed: int,
}

export component AppWindow inherits Window {
    title: "Deskemy";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: #0e0f12;
    default-font-size: 14px;

    in property <string> status;
    in property <[CourseRow]> courses;

    // Video: mpv renders into a GL texture that Rust hands us here. Rust reads
    // the element's size back to render at exactly its physical resolution.
    in property <bool> playing;
    in property <image> video-frame;
    in property <string> overlay-text;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;

    video := Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.video-frame;
        image-fit: fill;
        visible: root.playing;
    }

    // Anything after the video in the tree draws on top of it.
    if root.playing: Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: 44px;
        background: #000000b3;

        Text {
            x: 16px;
            text: root.overlay-text;
            color: #f2f2f3;
            vertical-alignment: center;
        }
    }

    if !root.playing: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 32px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "Deskemy";
            font-size: 28px;
            font-weight: 700;
            color: #f2f2f3;
        }

        Text {
            text: root.status;
            color: #8b8d94;
        }

        Rectangle { height: 16px; }

        for course in root.courses: HorizontalLayout {
            spacing: 12px;
            Text {
                text: course.title;
                color: #e4e5e8;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: course.completed + " / " + course.lectures + " lectures";
                color: #8b8d94;
            }
        }
    }
}
