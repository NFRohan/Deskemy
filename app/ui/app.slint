// Deskemy — Slint frontend (port in progress; see docs/slint-port.md).

import "fonts/InterVariable.ttf";

import {
    BookmarkRow, LectureRow, MenuItem, Playback, PlayerOverlay, ResourceGroup, ResourceItem, SectionRow,
    StatGroup, StatLine, StatRow,
} from "player.slint";
import { CoursePanel } from "course_panel.slint";
import { Nav, Sidebar, TopBar, WindowChrome } from "shell.slint";
import { CourseCard, Hero, Library, LibraryPage, SelectOption } from "library.slint";
import { Course, CourseDialogs, CoursePage, CurriculumLecture, CurriculumSection } from "course.slint";
import {
    BookmarkEntry, BookmarkGroup, BookmarksPage, FavoritesPage, HistoryGroup, HistoryPage, HistoryRow, Lists,
} from "pages.slint";
import { Search, SearchPage, SearchRow, SubtitleRow } from "search.slint";
import { PickRow, TrackCard, TrackCourseRow, TrackDialogs, TrackPage, Tracks, TracksPage } from "career.slint";
import { LearningStats, StatsPage, WeekBar } from "stats_page.slint";
import { ImportConfirm, Prefs, SettingsPage } from "settings.slint";
import { Theme } from "theme.slint";

export {
    BookmarkEntry, BookmarkGroup, HistoryGroup, HistoryRow, Lists, Search, SearchRow, SubtitleRow,
    PickRow, TrackCard, TrackCourseRow, Tracks, LearningStats, WeekBar, Prefs,
    BookmarkRow, Course, CourseCard, CurriculumLecture, CurriculumSection, Hero, LectureRow, Library, MenuItem,
    Nav, Playback, ResourceGroup, ResourceItem, SectionRow, SelectOption, StatGroup, StatLine, StatRow, Theme,
    WindowChrome,
}

export component AppWindow inherits Window {
    title: "Deskemy";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    // Frameless: the top bar (and the player's header) are the title bar.
    no-frame: true;
    resize-border-width: root.maximized || Playback.fullscreen ? 0px : 6px;
    background: root.playing ? #000000 : Theme.background;
    default-font-family: "Inter Variable";
    default-font-size: 14px;

    // Keep the maximize/restore glyph honest however the window changed
    // (button, double-click, Win+↑, snapping).
    changed maximized => { WindowChrome.maximized = root.maximized; }

    /// Re-read the library (after watching, progress has changed).
    callback refresh-library();
    /// A page came into view (load its data).
    callback page-shown(string);
    property <string> page: Nav.page;
    changed page => { root.page-shown(root.page); }

    // Video: mpv renders into a GL texture that Rust hands us here. Rust reads
    // the element's size back to render at exactly its physical resolution.
    in property <bool> playing;
    in property <image> video-frame;
    // The course panel sits beside the video, which narrows to make room.
    property <length> panel-width: root.playing && Playback.panel-open ? 340px : 0px;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;

    video := Image {
        x: 0;
        y: 0;
        width: parent.width - root.panel-width;
        height: parent.height;
        source: root.video-frame;
        image-fit: fill;
        visible: root.playing;
    }

    // Anything after the video in the tree draws on top of it.
    if root.playing: PlayerOverlay {
        // Explicit x: a fixed-width child is otherwise centred in its parent.
        x: 0;
        width: parent.width - root.panel-width;
        height: parent.height;
    }

    if root.playing && Playback.panel-open: CoursePanel {
        x: parent.width - root.panel-width;
        width: root.panel-width;
        height: parent.height;
    }

    // Everything but the player: sidebar, top bar and the current page.
    if !root.playing: HorizontalLayout {
        width: parent.width;
        height: parent.height;

        Sidebar { }

        VerticalLayout {
            horizontal-stretch: 1;
            TopBar { }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.background;

                if Nav.page == "library": LibraryPage { }
                if Nav.page == "course": CoursePage { }
                if Nav.page == "favorites": FavoritesPage { }
                if Nav.page == "history": HistoryPage { }
                if Nav.page == "bookmarks": BookmarksPage { }
                if Nav.page == "search": SearchPage { }
                if Nav.page == "tracks": TracksPage { }
                if Nav.page == "track": TrackPage { }
                if Nav.page == "stats": StatsPage { }
                if Nav.page == "settings": SettingsPage { }
            }
        }
    }

    // Page dialogs dim the whole window, sidebar included.
    if !root.playing && Nav.page == "course" && Course.dialog != "": CourseDialogs {
        width: parent.width;
        height: parent.height;
    }
    if !root.playing && Nav.page == "settings" && Prefs.import-confirm: ImportConfirm {
        width: parent.width;
        height: parent.height;
    }
    if !root.playing && (Nav.page == "tracks" || Nav.page == "track") && Tracks.dialog != "": TrackDialogs {
        width: parent.width;
        height: parent.height;
    }
}
