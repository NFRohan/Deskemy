// Deskemy — Slint frontend (port in progress; see docs/slint-port.md).

import {
    BookmarkRow, LectureRow, MenuItem, Playback, PlayerOverlay, ResourceGroup, ResourceItem, SectionRow,
} from "player.slint";
import { CoursePanel } from "course_panel.slint";

export { BookmarkRow, LectureRow, MenuItem, Playback, ResourceGroup, ResourceItem, SectionRow }

export struct CourseRow {
    id: string,
    /// Lecture to resume ("" = start from the first one).
    resume: string,
    title: string,
    lectures: int,
    completed: int,
}

export component AppWindow inherits Window {
    title: "Deskemy";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: root.playing ? #000000 : #0e0f12;
    default-font-size: 14px;

    in property <string> status;
    in property <[CourseRow]> courses;
    callback open-course(CourseRow);
    callback refresh-library();

    // Video: mpv renders into a GL texture that Rust hands us here. Rust reads
    // the element's size back to render at exactly its physical resolution.
    in property <bool> playing;
    in property <image> video-frame;
    // The course panel sits beside the video, which narrows to make room.
    property <length> panel-width: root.playing && Playback.panel-open ? 340px : 0px;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;

    video := Image {
        x: 0;
        y: 0;
        width: parent.width - root.panel-width;
        height: parent.height;
        source: root.video-frame;
        image-fit: fill;
        visible: root.playing;
    }

    // Anything after the video in the tree draws on top of it.
    if root.playing: PlayerOverlay {
        // Explicit x: a fixed-width child is otherwise centred in its parent.
        x: 0;
        width: parent.width - root.panel-width;
        height: parent.height;
    }

    if root.playing && Playback.panel-open: CoursePanel {
        x: parent.width - root.panel-width;
        width: root.panel-width;
        height: parent.height;
    }

    if !root.playing: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 32px;
        spacing: 2px;
        alignment: start;

        Text {
            text: "Deskemy";
            font-size: 28px;
            font-weight: 700;
            color: #f2f2f3;
        }

        Text {
            text: root.status;
            color: #8b8d94;
        }

        Rectangle { height: 16px; }

        for course in root.courses: Rectangle {
            border-radius: 6px;
            background: row-touch.has-hover ? #1b1d22 : transparent;

            HorizontalLayout {
                padding: 8px;
                spacing: 12px;
                Text {
                    text: course.title;
                    color: #e4e5e8;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: course.completed + " / " + course.lectures + " lectures";
                    color: #8b8d94;
                }
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-course(course); }
            }
        }
    }
}
