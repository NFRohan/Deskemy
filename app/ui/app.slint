// Deskemy — Slint frontend (port in progress; see docs/slint-port.md).

import { MenuItem, Playback, PlayerOverlay } from "player.slint";

export { MenuItem, Playback }

export struct CourseRow {
    id: string,
    /// Lecture to resume ("" = start from the first one).
    resume: string,
    title: string,
    lectures: int,
    completed: int,
}

export component AppWindow inherits Window {
    title: "Deskemy";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: root.playing ? #000000 : #0e0f12;
    default-font-size: 14px;

    in property <string> status;
    in property <[CourseRow]> courses;
    callback open-course(CourseRow);
    callback refresh-library();

    // Video: mpv renders into a GL texture that Rust hands us here. Rust reads
    // the element's size back to render at exactly its physical resolution.
    in property <bool> playing;
    in property <image> video-frame;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;

    video := Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.video-frame;
        image-fit: fill;
        visible: root.playing;
    }

    // Anything after the video in the tree draws on top of it.
    if root.playing: PlayerOverlay {
        width: parent.width;
        height: parent.height;

        title: Playback.title;
        subtitle: Playback.subtitle;
        stats: Playback.stats;
        clock: Playback.clock;
        ends-at: Playback.ends-at;
        up-next: Playback.up-next;
        position: Playback.position;
        duration: Playback.duration;
        paused: Playback.paused;
        volume: Playback.volume;
        muted: Playback.muted;
        fullscreen: Playback.fullscreen;
        has-previous: Playback.has-previous;
        has-next: Playback.has-next;
        speed-label: Playback.speed-label;
        subtitles-on: Playback.subtitles-on;
        speeds: Playback.speeds;
        subtitles: Playback.subtitles;
        audio-tracks: Playback.audio-tracks;
        chapters: Playback.chapters;
        open-menu <=> Playback.open-menu;

        back => { Playback.back(); }
        toggle-pause => { Playback.toggle-pause(); }
        seek(t) => { Playback.seek(t); }
        seek-by(d) => { Playback.seek-by(d); }
        previous => { Playback.previous(); }
        next => { Playback.next(); }
        set-volume(v) => { Playback.set-volume(v); }
        toggle-mute => { Playback.toggle-mute(); }
        toggle-fullscreen => { Playback.toggle-fullscreen(); }
        pick-speed(i) => { Playback.pick-speed(i); }
        pick-subtitle(id) => { Playback.pick-subtitle(id); }
        pick-audio(id) => { Playback.pick-audio(id); }
        pick-chapter(i) => { Playback.pick-chapter(i); }
    }

    if !root.playing: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 32px;
        spacing: 2px;
        alignment: start;

        Text {
            text: "Deskemy";
            font-size: 28px;
            font-weight: 700;
            color: #f2f2f3;
        }

        Text {
            text: root.status;
            color: #8b8d94;
        }

        Rectangle { height: 16px; }

        for course in root.courses: Rectangle {
            border-radius: 6px;
            background: row-touch.has-hover ? #1b1d22 : transparent;

            HorizontalLayout {
                padding: 8px;
                spacing: 12px;
                Text {
                    text: course.title;
                    color: #e4e5e8;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: course.completed + " / " + course.lectures + " lectures";
                    color: #8b8d94;
                }
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-course(course); }
            }
        }
    }
}
