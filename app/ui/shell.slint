// The app shell: frameless-window chrome, the top bar and the sidebar — the
// Tauri app's TopBar.svelte / Sidebar.svelte.

import { Theme } from "theme.slint";
import { AddFolderButton, Import } from "import.slint";

/// Window actions (carried out in Rust) and the state their buttons show.
export global WindowChrome {
    in property <bool> maximized;
    /// The pointer is on / pressed on the maximize button, as Windows tells
    /// it (over that button its input goes to Windows, for Snap Layouts).
    in property <bool> max-hover;
    in property <bool> max-pressed;
    callback minimize();
    callback toggle-maximize();
    callback close();
}

/// Which page is showing, and the breadcrumbs for it.
export global Nav {
    in-out property <string> page: "library";
    in-out property <[string]> crumbs: ["Library"];
    /// The page each crumb leads back to ("" = not a link).
    in-out property <[string]> crumb-targets: [""];
    in-out property <bool> sidebar-collapsed;
}

/// A small title bar button (the player's back arrow): a Lucide glyph on a
/// rounded hover background.
component WindowButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <bool> danger;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? Theme.error.transparentize(0.2) : Theme.surface-container-highest)
        : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: touch.has-hover ? Theme.on-surface : Theme.on-surface-variant;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// A caption button as Windows draws them: 46x32, flush with the window's
/// top edge, a thin 10px glyph, a tint on hover (solid red for close).
component CaptionButton inherits Rectangle {
    in property <string> label;
    /// The glyph, as path commands on a 10x10 box.
    in property <string> glyph;
    in property <bool> danger;
    /// Hover / press reported from outside (the maximize button's, by Windows).
    in property <bool> os-hover;
    in property <bool> os-pressed;
    callback clicked;
    property <bool> hover: touch.has-hover || root.os-hover;
    property <bool> pressed: touch.pressed || root.os-pressed;

    width: 46px;
    height: 32px;
    background: root.danger && root.pressed ? #f1707a
        : root.danger && root.hover ? #e81123
        : root.pressed ? (Theme.dark ? #ffffff33 : #00000033)
        : root.hover ? (Theme.dark ? #ffffff1a : #0000001a)
        : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph;
        fill: transparent;
        stroke: root.danger && root.hover ? #ffffff : Theme.on-surface;
        stroke-width: 1px;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Minimize / maximize-restore / close, in the window's top-right corner.
export component WindowButtons inherits HorizontalLayout {
    CaptionButton {
        label: "Minimize";
        glyph: "M 0 5.5 L 10 5.5";
        clicked => { WindowChrome.minimize(); }
    }
    CaptionButton {
        label: WindowChrome.maximized ? "Restore" : "Maximize";
        os-hover: WindowChrome.max-hover;
        os-pressed: WindowChrome.max-pressed;
        // Restore: a square with another behind it, up and to the right.
        glyph: WindowChrome.maximized
            ? "M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5"
            : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
        clicked => { WindowChrome.toggle-maximize(); }
    }
    CaptionButton {
        label: "Close";
        glyph: "M 0 0 L 10 10 M 10 0 L 0 10";
        danger: true;
        clicked => { WindowChrome.close(); }
    }
}

/// The 48px title bar: drag it to move the window, double-click to maximize;
/// breadcrumbs on the left (the last is where you are; others with a target
/// are links), window buttons on the right.
export component TitleBar inherits Rectangle {
    in property <[string]> crumbs;
    /// Per crumb, where it leads ("" = not a link).
    in property <[string]> targets;
    callback picked(int);
    /// A back arrow before the breadcrumbs.
    in property <bool> back-button;
    callback back();

    height: 48px;
    background: Theme.surface;

    WindowMoveArea {
        TouchArea {
            double-clicked => { WindowChrome.toggle-maximize(); }
        }

        HorizontalLayout {
            padding-left: root.back-button ? 8px : 16px;
            // Room for the caption buttons (3 x 46px), which sit in the corner.
            padding-right: 3 * 46px + 8px;
            spacing: 6px;

            if root.back-button: HorizontalLayout {
                padding-right: 4px;
                WindowButton {
                    y: (parent.height - self.height) / 2;
                    label: "Back";
                    icon: @image-url("icons/arrow-left.svg");
                    clicked => { root.back(); }
                }
            }
            for crumb[i] in root.crumbs: HorizontalLayout {
                spacing: 6px;
                if i > 0: Text {
                    text: "/";
                    color: Theme.outline-variant;
                    font-size: Theme.label-md;
                    vertical-alignment: center;
                }
                Text {
                    property <bool> link: i < root.crumbs.length - 1 && i < root.targets.length
                        && root.targets[i] != "";
                    text: crumb;
                    color: i == root.crumbs.length - 1 || (self.link && crumb-touch.has-hover)
                        ? Theme.on-surface : Theme.on-surface-variant;
                    font-size: Theme.label-md;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    crumb-touch := TouchArea {
                        enabled: parent.link;
                        mouse-cursor: parent.link ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.picked(i); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        WindowButtons {
            x: parent.width - 3 * 46px;
            y: 0;
            width: 3 * 46px;
            height: 32px;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.outline-variant;
    }
}

/// The title bar over the pages, following `Nav`.
export component TopBar inherits TitleBar {
    crumbs: Nav.crumbs;
    targets: Nav.crumb-targets;
    picked(i) => {
        Nav.page = Nav.crumb-targets[i];
        Nav.crumbs = [Nav.crumbs[i]];
        Nav.crumb-targets = [""];
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <bool> collapsed;
    callback clicked;

    height: 40px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: root.active ? Theme.surface-container-high : touch.has-hover ? Theme.surface-container-highest : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    // The active page's accent bar.
    Rectangle {
        x: 0;
        width: 4px;
        background: root.active ? Theme.secondary-container : transparent;
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 16px;
        spacing: 12px;
        alignment: root.collapsed ? center : start;

        Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            colorize: root.active ? Theme.on-surface : Theme.on-surface-variant;
        }
        if !root.collapsed: Text {
            text: root.label;
            color: root.active ? Theme.on-surface : Theme.on-surface-variant;
            font-size: Theme.body-md;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The left sidebar: brand, collapse control and the page list.
export component Sidebar inherits Rectangle {
    width: Nav.sidebar-collapsed ? 64px : 240px;
    animate width { duration: 200ms; }
    background: Theme.surface-container-low;
    clip: true;

    property <[{ id: string, label: string, icon: image }]> items: [
        { id: "library", label: "Library", icon: @image-url("icons/library.svg") },
        { id: "search", label: "Search", icon: @image-url("icons/search.svg") },
        { id: "tracks", label: "Career Tracks", icon: @image-url("icons/route.svg") },
        { id: "favorites", label: "Favorites", icon: @image-url("icons/star.svg") },
        { id: "bookmarks", label: "Bookmarks", icon: @image-url("icons/bookmark.svg") },
        { id: "history", label: "History", icon: @image-url("icons/history.svg") },
        { id: "stats", label: "Stats", icon: @image-url("icons/chart-column.svg") },
        { id: "settings", label: "Settings", icon: @image-url("icons/settings.svg") },
    ];

    VerticalLayout {
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 32px;

        // Brand + collapse control. Collapsed, the expander stands in for the logo.
        HorizontalLayout {
            height: 32px;
            padding-left: Nav.sidebar-collapsed ? 0px : 24px;
            padding-right: Nav.sidebar-collapsed ? 0px : 16px;
            spacing: 12px;
            alignment: Nav.sidebar-collapsed ? center : stretch;

            if !Nav.sidebar-collapsed: Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                clip: true;
                Image {
                    source: @image-url("logo.png");
                    width: 32px;
                    height: 32px;
                }
            }
            if !Nav.sidebar-collapsed: Text {
                text: "Deskemy";
                color: Theme.primary;
                font-size: Theme.headline-md;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: toggle-touch.has-hover ? Theme.surface-container-highest : transparent;
                accessible-role: button;
                accessible-label: Nav.sidebar-collapsed ? "Expand sidebar" : "Collapse sidebar";
                Image {
                    source: Nav.sidebar-collapsed ? @image-url("icons/panel-left-open.svg") : @image-url("icons/panel-left-close.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.on-surface-variant;
                }
                toggle-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Nav.sidebar-collapsed = !Nav.sidebar-collapsed; }
                }
            }
        }

        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: start;
            vertical-stretch: 1;

            for item in root.items: NavItem {
                label: item.label;
                icon: item.icon;
                collapsed: Nav.sidebar-collapsed;
                // A course page counts as the library, a track as the tracks.
                active: Nav.page == item.id || (item.id == "library" && Nav.page == "course")
                    || (item.id == "tracks" && Nav.page == "track");
                clicked => {
                    Nav.page = item.id;
                    Nav.crumbs = [item.label];
                    Nav.crumb-targets = [""];
                }
            }
        }

        // Add Folder, with the last failure above it (the preview shows its own).
        VerticalLayout {
            padding-left: Nav.sidebar-collapsed ? 8px : 16px;
            padding-right: self.padding-left;
            spacing: 8px;
            if Import.error != "" && !Import.open && !Nav.sidebar-collapsed: Text {
                text: Import.error;
                color: Theme.error;
                font-size: Theme.label-sm;
                wrap: word-wrap;
                overflow: elide;
                max-height: 36px;
                max-width: root.width - 32px;
            }
            AddFolderButton {
                collapsed: Nav.sidebar-collapsed;
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.outline-variant;
    }
}
